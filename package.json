{
  "name": "wirdy",
  "version": "0.1.0",
  "private": true,
  "description": "وِردي: the daily adhkar that are authentic from the Prophet ﷺ, each with its takhrij.",
  "license": "MIT",
  "author": "Raaqim (https://raaqim.org)",
  "homepage": "https://wirdy.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raaqimorg/wirdy.git"
  },
  "bugs": {
    "url": "https://github.com/raaqimorg/wirdy/issues"
  },
  "funding": "https://github.com/sponsors/raaqimorg",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "ci": "astro sync && bun run format:check && bun run lint && bun run check && bun run test && bun run test:scripts && bun run test:build",
    "check": "astro check",
    "lint": "astro sync && oxlint --type-aware --deny-warnings && stylelint \"src/**/*.css\"",
    "format": "oxfmt && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --check && prettier --check \"src/**/*.astro\"",
    "test": "vitest run",
    "test:scripts": "bun test scripts",
    "test:build": "vitest run --config vitest.build.config.ts",
    "opengraph": "bun scripts/opengraph/build.ts",
    "opengraph:adhkar": "bun scripts/opengraph/adhkar.ts",
    "posters": "bun scripts/posters/build.ts",
    "drift": "bun scripts/drift/capture.ts",
    "drift:check": "bun scripts/drift/capture.ts --check",
    "icons": "bun scripts/icons/build.ts",
    "verification": "bun scripts/verification/status.ts",
    "verification:import": "bun scripts/verification/import.ts",
    "verification:claim": "bun scripts/verification/claim.ts",
    "verification:difference": "bun scripts/verification/difference.ts",
    "verification:absent": "bun scripts/verification/absent.ts",
    "verification:ruling": "bun scripts/verification/ruling.ts",
    "promo:check": "bun scripts/promo/check.ts",
    "promo:clip": "bun scripts/promo/clip.ts",
    "promo:render": "bun scripts/promo/render.ts",
    "promo:sheet": "bun scripts/promo/sheet.ts",
    "visits": "bun scripts/visits/send.ts",
    "visits:deploy": "env -u CLOUDFLARE_API_TOKEN -u CLOUDFLARE_ZONE_ID wrangler deploy --config scripts/visits/wrangler.toml --env-file=/dev/null",
    "deploy": "bun run ci && env -u CLOUDFLARE_API_TOKEN -u CLOUDFLARE_ZONE_ID wrangler pages deploy --env-file=/dev/null",
    "gallery": "bun scripts/gallery/serve.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "astro": "^7.2.2",
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@effect/language-service": "0.87.5",
    "@effect/platform-node": "4.1.5",
    "@effect/vitest": "4.1.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.2.0",
    "gray-matter": "^4.0.3",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "playwright-core": "^1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.123.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4"
  }
}
