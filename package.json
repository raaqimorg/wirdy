{
  "name": "wirdy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "ci": "bun run format:check && bun run lint && bun run check && bun run test && bun run test:scripts && bun run test:build",
    "check": "astro check",
    "lint": "oxlint --deny-warnings && stylelint \"src/**/*.css\"",
    "format": "oxfmt && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --check && prettier --check \"src/**/*.astro\"",
    "test": "vitest run",
    "test:scripts": "bun test scripts",
    "test:build": "vitest run --config vitest.build.config.ts",
    "opengraph": "bun scripts/opengraph/build.mjs",
    "opengraph:adhkar": "bun scripts/opengraph/adhkar.mjs",
    "icons": "bun scripts/icons/build.mjs",
    "verification": "bun scripts/verification/status.mjs",
    "deploy": "bun run ci && wrangler pages deploy"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "astro": "^7.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.2.0",
    "gray-matter": "^4.0.3",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.123.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4"
  }
}
