{
  "extends": "stylelint-config-standard",
  "reportNeedlessDisables": true,
  "rules": {
    "alpha-value-notation": null,
    "color-function-alias-notation": null,
    "color-function-notation": null,
    "color-named": "never",
    "color-no-hex": true,
    "custom-property-empty-line-before": null,
    "declaration-block-no-duplicate-properties": [
      true,
      {
        "ignore": ["consecutive-duplicates-with-different-values"]
      }
    ],
    "declaration-no-important": true,
    "property-disallowed-list": [
      "margin-left",
      "margin-right",
      "padding-left",
      "padding-right",
      "border-left",
      "border-right",
      "left",
      "right",
      "margin-top",
      "margin-bottom",
      "padding-top",
      "padding-bottom",
      "border-top",
      "border-bottom",
      "top",
      "bottom"
    ],
    "declaration-property-unit-disallowed-list": {
      "/^(font-size|letter-spacing|word-spacing|text-indent)$/": [
        "px",
        "rem",
        "em",
        "ex",
        "ch",
        "lh",
        "rlh",
        "cap",
        "ic",
        "vw",
        "vh",
        "vi",
        "vb",
        "vmin",
        "vmax",
        "dvh",
        "svh",
        "lvh",
        "dvw",
        "svw",
        "lvw",
        "cqi",
        "cqb",
        "cqw",
        "cqh",
        "cqmin",
        "cqmax",
        "cm",
        "mm",
        "in",
        "pt",
        "pc",
        "q",
        "%"
      ],
      "/^(margin|padding|gap|row-gap|column-gap|scroll-margin|scroll-padding)/": [
        "px",
        "rem",
        "em",
        "ex",
        "ch",
        "lh",
        "rlh",
        "cap",
        "ic",
        "vw",
        "vh",
        "vi",
        "vb",
        "vmin",
        "vmax",
        "dvh",
        "svh",
        "lvh",
        "dvw",
        "svw",
        "lvw",
        "cqi",
        "cqb",
        "cqw",
        "cqh",
        "cqmin",
        "cqmax",
        "cm",
        "mm",
        "in",
        "pt",
        "pc",
        "q",
        "%"
      ],
      "/^(inset|top|bottom|left|right)/": ["rem", "px"],
      "/^(transition|animation)(-duration|-delay)?$/": ["ms", "s"],
      "/^--/": ["rem", "px", "ms", "s"],
      "/(radius|offset|thickness)$/": [
        "px",
        "rem",
        "em",
        "ex",
        "ch",
        "lh",
        "rlh",
        "cap",
        "ic",
        "vw",
        "vh",
        "vi",
        "vb",
        "vmin",
        "vmax",
        "dvh",
        "svh",
        "lvh",
        "dvw",
        "svw",
        "lvw",
        "cqi",
        "cqb",
        "cqw",
        "cqh",
        "cqmin",
        "cqmax",
        "cm",
        "mm",
        "in",
        "pt",
        "pc",
        "q",
        "%"
      ],
      "/(width|height|size|basis)$/": ["px"],
      "/^(border|outline|font|flex|text)/": ["rem", "px", "em"],
      "/^stroke-width$/": [
        "px",
        "rem",
        "em",
        "ex",
        "ch",
        "lh",
        "rlh",
        "cap",
        "ic",
        "vw",
        "vh",
        "vi",
        "vb",
        "vmin",
        "vmax",
        "dvh",
        "svh",
        "lvh",
        "dvw",
        "svw",
        "lvw",
        "cqi",
        "cqb",
        "cqw",
        "cqh",
        "cqmin",
        "cqmax",
        "cm",
        "mm",
        "in",
        "pt",
        "pc",
        "q",
        "%"
      ],
      "/^grid-template/": ["px"],
      "/^grid-(?!template)/": ["rem", "px"]
    },
    "declaration-property-value-disallowed-list": {
      "/^(line-height|font-weight|z-index)$/": ["/^[0-9]/", "/^(bold|normal|bolder|lighter)$/"],
      "font": ["/./"],
      "font-family": ["/^(?!var\\()/"],
      "/radius$/": ["/[1-9]/"],
      "/^(border|outline)(-(top|right|bottom|left|block|inline)(-(start|end))?)?(-width)?$/": [
        "/\\b(thin|medium|thick)\\b/"
      ],
      "/^(font-size)$/": [
        "/^(xx-small|x-small|small|medium|large|x-large|xx-large|xxx-large|smaller|larger)$/"
      ]
    },
    "function-disallowed-list": [
      "rgb",
      "rgba",
      "hsl",
      "hsla",
      "hwb",
      "lab",
      "lch",
      "oklab",
      "oklch",
      "color",
      "color-mix",
      "light-dark",
      "cubic-bezier"
    ],
    "hue-degree-notation": null,
    "import-notation": "string",
    "media-feature-name-value-allowed-list": {
      "min-width": ["40rem", "64rem"],
      "max-width": ["40rem", "63.99rem"]
    },
    "media-feature-range-notation": "prefix",
    "no-descending-specificity": null,
    "property-no-vendor-prefix": [
      true,
      {
        "ignoreProperties": ["/user-select$/", "/text-size-adjust$/"]
      }
    ],
    "selector-class-pattern": [
      "^[a-z]+(-[a-z]+)*(__[a-z]+(-[a-z]+)*)?(--[a-z]+(-[a-z]+)*)?$",
      {
        "message": "Name a class block__element--modifier"
      }
    ],
    "selector-max-id": 0,
    "value-keyword-case": [
      "lower",
      {
        "camelCaseSvgKeywords": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/styles/tokens.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "function-disallowed-list": null,
        "declaration-property-unit-disallowed-list": null
      }
    },
    {
      "files": ["src/styles/fonts.css"],
      "rules": {
        "declaration-property-value-disallowed-list": null
      }
    }
  ]
}
