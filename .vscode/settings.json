{
  "editor.rulers": [100],
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.eol": "\n",
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.astro": true,
    "bun.lock": true
  },
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/graft": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/.astro": true,
    "**/.wrangler": true,
    "**/*.tsbuildinfo": true,
    ".claude/worktrees": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "bun.lock, tsconfig.json, astro.config.ts, vitest*.config.ts, wrangler.toml, .oxlintrc.json, .oxfmtrc.json, .prettierrc.json, .stylelintrc.json",
    "README.md": "LICENSE, NOTICE",
    "AGENTS.md": "CLAUDE.md, GEMINI.md",
    ".gitignore": ".ignore",
    "*.ts": "${capture}.test.ts",
    "*.astro": "${capture}.test.ts",
    "*.sh": "${capture}.test.ts",
    "*.md": "${capture}.html, ${capture}-plan.md",
    "schema.ts": "content.test.ts",
    "records.ts": "proofs.test.ts",
    "permalink.ts": "permalinks.json",
    "index.css": "fonts.css, tokens.css, base.css, utilities.css, styles.test.ts",
    "favicon.svg": "favicon.ico, favicon-32x32.png, apple-touch-icon.png, icon-192.png, icon-512.png",
    "opengraph.png": "opengraph-*.png"
  },
  "npm.packageManager": "bun"
}
