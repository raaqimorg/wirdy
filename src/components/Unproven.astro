---
import Badge from './Badge.astro';
import Entry from './Entry.astro';
import { soundPlace } from '../lib/sound';
import { isOneWord } from '../lib/takhrij';
import type { Unproven } from '../lib/schema';

interface Props {
  data: Unproven;
  body: string;
  slug: string;
}

const { data, body, slug } = Astro.props;
const place = data.sound ? soundPlace(data.sound) : null;
---

<Entry
  takhrij={data.takhrij}
  id={slug}
  lead={data.what}
  layout="split"
  kind="unproven"
  sound={Boolean(data.sound)}
>
  {isOneWord(data.takhrij.ruling) && <Badge slot="badge">{data.takhrij.ruling}</Badge>}
  <Fragment>{body.trim()}</Fragment>
  {place && (
    <Fragment slot="sound">
      {place.before}
      <a class="entry__link" href={place.path}>
        {place.name}
      </a>
      {place.after}
    </Fragment>
  )}
  {data.sound && !place && <Fragment slot="sound">{data.sound}</Fragment>}
</Entry>
