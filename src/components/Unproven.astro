---
import Badge from './Badge.astro';
import Entry from './Entry.astro';
import { soundPlace } from '../lib/sound';
import { isOneWord } from '../lib/takhrij';
import type { Unproven } from '../lib/schema';

interface Props {
  data: Unproven;
  body: string;
}

const { data, body } = Astro.props;
const place = data.sound ? soundPlace(data.sound) : null;
---

<Entry takhrij={data.takhrij} lead={data.what} layout="split" kind="unproven">
  {isOneWord(data.takhrij.ruling) && <Badge slot="badge">{data.takhrij.ruling}</Badge>}
  <Fragment>{body.trim()}</Fragment>
  {place && (
    <p slot="note" class="entry__note entry__note--sound">
      {place.before}
      <a class="entry__note-link" href={place.path}>
        {place.name}
      </a>
      {place.after}
    </p>
  )}
  {data.sound && !place && (
    <p slot="note" class="entry__note">
      {data.sound}
    </p>
  )}
</Entry>
