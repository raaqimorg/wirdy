---
import Icon from './Icon.astro';

interface Props {
  variant: 'round' | 'field' | 'hero';
}

const { variant } = Astro.props;
const label = 'ابحث في الأذكار';
---

{variant === 'round' ? (
  <a
    class="search-trigger search-trigger--round"
    href="/bahth/"
    aria-label={label}
    data-search-open
  >
    <span class="search-trigger__face">
      <Icon name="search" />
    </span>
  </a>
) : (
  <a class={`search-trigger search-trigger--${variant}`} href="/bahth/" data-search-open>
    <Icon name="search" />
    <span class="search-trigger__label">{label}</span>
  </a>
)}
