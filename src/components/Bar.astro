---
import Icon from './Icon.astro';
import IconButton from './IconButton.astro';
import Mark from './Mark.astro';
import SectionMenu from './SectionMenu.astro';
import Tools from './Tools.astro';
import { SITE } from '../lib/site';

interface Props {
  heading?: string;
  back?: { href: string; label: string };
}

const { heading, back } = Astro.props;
---

<nav class="bar" aria-label="التنقّل">
  {back ? (
    <a class="bar__back" href={back.href}>
      <Icon name="back" />
      {back.label}
    </a>
  ) : (
    <Fragment>
      <SectionMenu />
      <a class="bar__back bar__back--fallback" href="/">
        <Icon name="back" />
        كل الأقسام
      </a>
    </Fragment>
  )}
  {heading && (
    <span class="bar__title" aria-hidden="true">
      {heading}
    </span>
  )}
  <Tools>
    <IconButton label="البحث" variant="glass" href="/bahth/">
      <Icon name="search" />
    </IconButton>
    <IconButton label={`${SITE.name}، الرئيسية`} href="/">
      <Mark inks="stage" />
    </IconButton>
  </Tools>
</nav>
