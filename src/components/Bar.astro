---
import Icon from './Icon.astro';
import IconButton from './IconButton.astro';
import Mark from './Mark.astro';
import ThemeToggle from './ThemeToggle.astro';
import Tools from './Tools.astro';
import { SITE } from '../lib/site';

interface Props {
  heading?: string;
  back?: { href: string; label: string };
}

const { heading, back = { href: '/', label: 'كل الأقسام' } } = Astro.props;
---

<nav class="bar" aria-label="التنقّل">
  <a class="bar__back" href={back.href}>
    <Icon name="back" />
    {back.label}
  </a>
  {heading && (
    <span class="bar__title" aria-hidden="true">
      {heading}
    </span>
  )}
  <Tools>
    <ThemeToggle variant="glass" />
    <IconButton label={`${SITE.name}، الرئيسية`} variant="eggshell" href="/">
      <Mark />
    </IconButton>
  </Tools>
</nav>
