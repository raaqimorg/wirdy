---
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import SectionMenu from './SectionMenu.astro';
import { SITE } from '../lib/site';

interface Props {
  menu?: boolean | undefined;
  stage?: boolean | undefined;
}

const { menu = true, stage = false } = Astro.props;
const label = 'ابحث في الأذكار';
const here = Astro.url.pathname === '/bahth/';
---

<nav class:list={['bar', stage && 'bar--stage']} aria-label="التنقّل">
  <div class="bar__inner container">
    <a class="bar__brand" href="/" aria-label={`${SITE.name}، الرئيسية`}>
      <Mark inks={stage ? 'stage' : 'own'} />
      <span class="bar__name">{SITE.name}</span>
    </a>
    {menu && <SectionMenu />}
    <a
      class="bar__search"
      href="/bahth/"
      aria-label={label}
      aria-current={here ? 'page' : undefined}
      data-search-open
    >
      <Icon name="search" />
    </a>
  </div>
</nav>
