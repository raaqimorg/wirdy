---
import { Effect, Option } from 'effect';
import EntryList from './EntryList.astro';
import Group from './Group.astro';
import GroupIndex from './GroupIndex.astro';
import Hadith from './Hadith.astro';
import PageTools from './PageTools.astro';
import PosterMenu from './PosterMenu.astro';
import ReadingProgress from './ReadingProgress.astro';
import Related from './Related.astro';
import Section from '../layouts/Section.astro';
import { hadithLabel } from '../lib/arabic';
import { sectionCardFile } from '../lib/card';
import { hadithsOf, sectionTiles } from '../lib/collection';
import { runsByGroup } from '../lib/groups';
import { slugOf } from '../lib/permalink';
import { hadithPosterOf } from '../lib/poster';
import { GUIDES, type Guide } from '../lib/site';

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const { heading, title, color, path, topics } = GUIDES[guide];
const entries = await Effect.runPromise(hadithsOf(guide));
const runs = runsByGroup(entries);
const poster = hadithPosterOf(guide, entries);
const groups = runs.flatMap(({ group }) => Option.toArray(group));
const others = (await Effect.runPromise(sectionTiles)).filter((tile) => tile.id !== guide);

const label = hadithLabel(entries.length);
const description = `${title}: ${label} صحيحة عن النبي ﷺ ${topics}، ومع كل حديث تخريجه`;
---

<Section
  title={title}
  description={description}
  image={`/${sectionCardFile({ id: guide, title, color, note: label })}`}
  crumbs={[{ name: title, path }]}
  emblem={guide}
  color={color}
  heading={heading}
  kicker={label}
>
  <PosterMenu slot="bar" posters={[poster]} title={title} path={path} />
  <PageTools>
    <GroupIndex groups={groups} />
  </PageTools>
  <ReadingProgress>
    {runs.map(({ group, items }) => (
      <Group title={Option.getOrUndefined(group)}>
        <EntryList variant="titled">
          {items.map(({ id, data, body = '' }) => (
            <Hadith guide={guide} data={data} body={body} slug={slugOf(id)} />
          ))}
        </EntryList>
      </Group>
    ))}
  </ReadingProgress>
  <Related slot="after" tiles={others} />
</Section>
