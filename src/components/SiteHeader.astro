---
import Mark from './Mark.astro';
import SearchTrigger from './SearchTrigger.astro';
import { SITE } from '../lib/site';

const search = Astro.url.pathname !== '/bahth/';
---

<header class="site-header container">
  <a class="site-header__brand" href="/">
    <Mark />
    <span class="site-header__name">{SITE.name}</span>
  </a>
  {search && (
    <span class="site-header__search">
      <SearchTrigger variant="field" />
    </span>
  )}
</header>
