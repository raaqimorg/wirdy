---
import Emblem from './Emblem.astro';
import type { Tile } from '../lib/collection';

interface Props {
  tile: Tile;
  variant: 'lead' | 'row' | 'band' | 'compact';
  motion: 'always' | 'wide-only' | 'still';
}

const { tile, variant, motion } = Astro.props;
const { id, heading, color, note, href } = tile;
---

<a
  class:list={[
    'occasion-card',
    variant === 'band' ? 'occasion-card--row occasion-card--band' : `occasion-card--${variant}`,
    'tone',
  ]}
  href={href}
  style={`--tone: ${color}`}
>
  <span class="occasion-card__stage">
    <Emblem name={id} motion={motion} class="occasion-card__emblem" />
  </span>
  <span class="occasion-card__body">
    <span class="occasion-card__title">{heading}</span>
    <span class="occasion-card__note">{note}</span>
  </span>
</a>
