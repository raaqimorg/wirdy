---
import Icon from './Icon.astro';
import { ayatLabel, toArabicDigits } from '../lib/arabic';

interface Props {
  ayat: ReadonlyArray<string>;
  rest?: ReadonlyArray<string> | undefined;
  from: number;
  place?: string | undefined;
}

const { ayat, rest = [], from, place } = Astro.props;
const folded = rest.length > 0;
---

<div class:list={['surah', folded && 'surah--fold']}>
  {ayat.map((ayah, i) => (
    <Fragment>
      {ayah}
      <span class="surah__ayah-end" data-ayah={`۝${toArabicDigits(from + i)}`} />
      {i < ayat.length - 1 && ' '}
    </Fragment>
  ))}
  {folded && (
    <details class="surah__rest">
      <summary class="surah__more" data-hover="fill">
        <span class="surah__closed">
          أكمل القراءة{place && <span class="visually-hidden">{`، ${place}`}</span>}
          {`، ${ayatLabel(rest.length)}`}
        </span>
        <span class="surah__opened">
          إخفاء{place && <span class="visually-hidden">{`، ${place}`}</span>}
        </span>
        <Icon name="chevron" class="surah__chevron" />
      </summary>
      <span class="surah__ayat">
        {rest.map((ayah, i) => (
          <Fragment>
            {ayah}
            <span
              class="surah__ayah-end"
              data-ayah={`۝${toArabicDigits(from + ayat.length + i)}`}
            />
            {i < rest.length - 1 && ' '}
          </Fragment>
        ))}
      </span>
    </details>
  )}
</div>
