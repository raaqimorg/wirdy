---
import Icon from './Icon.astro';
import { ayatLabel } from '../lib/arabic';

interface Props {
  ayat: ReadonlyArray<string>;
  rest?: ReadonlyArray<string> | undefined;
}

const { ayat, rest = [] } = Astro.props;
const folded = rest.length > 0;
---

<div class:list={['surah', folded && 'surah--fold']}>
  {ayat.map((ayah, i) => (
    <Fragment>
      {i > 0 && <span class="surah__ayah-end" />}
      {ayah}
    </Fragment>
  ))}
  {folded && (
    <Fragment>
      <span class="surah__ayah-end" />
      <details class="surah__rest">
        <summary class="surah__more" data-hover="fill">
          <span class="surah__closed">{`أكمل القراءة · ${ayatLabel(rest.length)}`}</span>
          <span class="surah__opened">إخفاء</span>
          <Icon name="chevron" class="surah__chevron" />
        </summary>
        <span class="surah__ayat">
          {rest.map((ayah, i) => (
            <Fragment>
              {i > 0 && <span class="surah__ayah-end" />}
              {ayah}
            </Fragment>
          ))}
        </span>
      </details>
    </Fragment>
  )}
</div>
