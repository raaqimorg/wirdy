---
import Button from './Button.astro';
import Entry from './Entry.astro';
import Icon from './Icon.astro';
import Phrase from './Phrase.astro';
import Surah from './Surah.astro';
import VariantText from './VariantText.astro';
import { Effect, Option } from 'effect';
import { timesLabel } from '../lib/arabic';
import { copyOf } from '../lib/copy';
import { foldOf, mannerOf, momentOf, suwarOf } from '../lib/lead';
import { dhikrPath } from '../lib/permalink';
import { phrasesOf } from '../lib/phrases';
import type { Dhikr } from '../lib/schema';
import { fullTitle, isOpening } from '../lib/title';
import { formOf } from '../lib/variants';

interface Props {
  data: Dhikr;
  body: string;
  slug: string;
  heading?: 'h2' | 'h3' | 'h4' | undefined;
  single?: boolean | undefined;
  nested?: boolean | undefined;
}

const { data, body, slug, heading, single = false, nested = false } = Astro.props;

const text = body.trim();
const suwar = suwarOf(data, text);
const folds = Option.getOrElse(
  Option.map(suwar, (all) =>
    all.map((ayat) => (data.ayat === 'fold' ? foldOf(ayat) : { shown: ayat, rest: [] }))
  ),
  () => []
);
const count = data.count > 1 ? timesLabel(data.count) : undefined;
const moment = momentOf(data) || undefined;
const how = mannerOf(data, suwar) || undefined;
const copy = Effect.runSync(copyOf(data, body));
const path = dhikrPath(data.occasion, slug);
const phrases = data.counts === undefined ? [] : Effect.runSync(phrasesOf(text, data.counts));
const plain = Option.isNone(suwar) && data.counts === undefined;
const title = fullTitle(data);
const opening = isOpening(data.title, Effect.runSync(formOf(text, 'sabah')));
---

<Entry
  takhrij={data.takhrij}
  id={slug}
  title={title}
  name={opening ? undefined : data.title}
  heading={heading}
  count={count}
  moment={moment}
  how={how}
  fadl={data.fadl}
  single={single}
  nested={nested}
  kind={data.quran ? 'quran' : undefined}
  phrases={phrases.length > 0}
  time={single || data.mode === 'both' ? undefined : data.mode}
>
  <Fragment>
    {folds.map(({ shown, rest }, i) => (
      <Surah ayat={shown} rest={rest} from={data.from?.[i] ?? 1} />
    ))}
    {phrases.map((phrase) => (
      <Phrase {...phrase} />
    ))}
    {plain && <VariantText text={text} />}
  </Fragment>
  {!single && (
    <div slot="actions" class="entry__acts">
      <span class="visually-hidden" role="status" data-status />
      <Button
        variant="text"
        class="entry__act"
        aria-label={`نسخ: ${title}`}
        data-copy={copy.sabah}
        data-copy-masaa={Option.getOrUndefined(copy.masaa)}
      >
        <Icon name="copy" class="icon--idle" />
        <Icon name="check" class="icon--done" />
        <Icon name="alert" class="icon--fail" />
        <span data-label>نسخ</span>
      </Button>
      <Button variant="text" class="entry__act" href={path} aria-label={`صفحة الذكر: ${title}`}>
        <span>صفحة الذكر</span>
        <Icon name="open" />
      </Button>
    </div>
  )}
</Entry>
