---
import BeadRing from './BeadRing.astro';
import Entry from './Entry.astro';
import Icon from './Icon.astro';
import Phrase from './Phrase.astro';
import Surah from './Surah.astro';
import VariantText from './VariantText.astro';
import { Effect, Option } from 'effect';
import { timesUnit, toArabicDigits } from '../lib/arabic';
import { copyOf } from '../lib/copy';
import { foldOf, leadOf, suwarOf } from '../lib/lead';
import { dhikrPath } from '../lib/permalink';
import { phrasesOf } from '../lib/phrases';
import type { Dhikr } from '../lib/schema';
import { fullTitle } from '../lib/title';

interface Props {
  data: Dhikr;
  body: string;
  slug: string;
  heading?: 'h2' | 'h3' | 'h4' | undefined;
  single?: boolean | undefined;
  nested?: boolean | undefined;
}

const { data, body, slug, heading, single = false, nested = false } = Astro.props;

const text = body.trim();
const suwar = suwarOf(data, text);
const folds = Option.getOrElse(
  Option.map(suwar, (all) =>
    all.map((ayat) => (data.ayat === 'fold' ? foldOf(ayat) : { shown: ayat, rest: [] }))
  ),
  () => []
);
const unit = data.count > 1 ? [timesUnit(data.count)] : [];
const lead = [...unit, leadOf(data, suwar)].filter((part) => part !== '').join('، ');
const copy = Effect.runSync(copyOf(data, body));
const path = dhikrPath(data.occasion, slug);
const phrases = data.counts === undefined ? [] : Effect.runSync(phrasesOf(text, data.counts));
const plain = Option.isNone(suwar) && data.counts === undefined;
const title = fullTitle(data);
---

<Entry
  takhrij={data.takhrij}
  id={slug}
  title={title}
  heading={heading}
  lead={lead}
  how={data.how}
  fadl={data.fadl}
  single={single}
  nested={nested}
  kind={data.quran ? 'quran' : undefined}
  time={single || data.mode === 'both' ? undefined : data.mode}
>
  {data.count > 1 && <BeadRing slot="count" count={data.count} />}
  {data.count > 2 && (
    <span slot="number" class="visually-hidden">
      {`${toArabicDigits(data.count)}\u00a0`}
    </span>
  )}
  <Fragment>
    {folds.map(({ shown, rest }) => (
      <Surah ayat={shown} rest={rest} />
    ))}
    {phrases.map((phrase) => (
      <Phrase {...phrase} />
    ))}
    {plain && <VariantText text={text} />}
  </Fragment>
  {!single && (
    <div slot="actions" class="entry__acts">
      <span class="entry__status" role="status" data-status />
      <button
        class="entry__act"
        type="button"
        aria-label={`نسخ: ${title}`}
        data-copy={copy.sabah}
        data-copy-masaa={Option.getOrUndefined(copy.masaa)}
      >
        <Icon name="copy" />
        <span class="entry__act-label">نسخ</span>
      </button>
      <a class="entry__act" href={path} aria-label={`صفحة الذكر: ${title}`}>
        <span class="entry__act-label">صفحة الذكر</span>
        <Icon name="open" />
      </a>
    </div>
  )}
</Entry>
