---
import BeadRing from './BeadRing.astro';
import Entry from './Entry.astro';
import Icon from './Icon.astro';
import IconButton from './IconButton.astro';
import Phrase from './Phrase.astro';
import Surah from './Surah.astro';
import VariantText from './VariantText.astro';
import { timesUnit, toArabicDigits } from '../lib/arabic';
import { copyOf } from '../lib/copy';
import { foldOf, leadOf, suwarOf } from '../lib/lead';
import { dhikrPath } from '../lib/permalink';
import { phrasesOf } from '../lib/phrases';
import type { Dhikr } from '../lib/schema';
import { fullTitle } from '../lib/title';

interface Props {
  data: Dhikr;
  body: string;
  slug: string;
  heading?: 'h2' | 'h3' | 'h4';
  single?: boolean;
  nested?: boolean;
}

const { data, body, slug, heading, single = false, nested = false } = Astro.props;

const text = body.trim();
const suwar = suwarOf(data, text);
const folds = suwar?.map((ayat) =>
  data.ayat === 'fold' ? foldOf(ayat) : { shown: ayat, rest: [] }
);
const unit = data.count > 1 ? timesUnit(data.count) : null;
const lead = [unit, leadOf(data, suwar)].filter(Boolean).join('، ');
const copy = copyOf(data, body);
const path = dhikrPath(data.occasion, slug);
const phrases = data.counts ? phrasesOf(text, data.counts) : null;
const title = fullTitle(data);
---

<Entry
  takhrij={data.takhrij}
  id={slug}
  title={title}
  heading={heading}
  lead={lead}
  how={data.how}
  layout={single ? 'single' : 'split'}
  nested={nested}
  kind={data.quran ? 'quran' : undefined}
  time={single || data.mode === 'both' ? undefined : data.mode}
>
  {data.count > 1 && <BeadRing slot="count" count={data.count} />}
  {data.count > 2 && (
    <span slot="number" class="visually-hidden">
      {`${toArabicDigits(data.count)}\u00a0`}
    </span>
  )}
  <Fragment>
    {folds && folds.map(({ shown, rest }) => <Surah ayat={shown} rest={rest} />)}
    {phrases && phrases.map((phrase) => <Phrase {...phrase} />)}
    {!suwar && !phrases && <VariantText text={text} />}
  </Fragment>
  {data.fadl && (
    <p slot="note" class="entry__note">
      {data.fadl}
    </p>
  )}
  {data.quran && (
    <p slot="note" class="entry__note entry__note--source">
      النص من{' '}
      <a class="entry__note-link" href="https://tanzil.net/" rel="noopener">
        تنزيل
      </a>
    </p>
  )}
  {!single && (
    <div slot="actions" class="entry__actions">
      <span class="entry__status" role="status" data-status />
      <IconButton
        label={`نسخ: ${title}`}
        variant="quiet"
        data-copy={copy.sabah}
        data-copy-masaa={copy.masaa}
      >
        <Icon name="copy" />
      </IconButton>
      <IconButton label={`صفحة الذكر: ${title}`} variant="quiet" href={path}>
        <Icon name="open" />
      </IconButton>
    </div>
  )}
</Entry>
