---
import Button from './Button.astro';
import Icon from './Icon.astro';
---

<div class="search-field search-field--bar">
  <label class="search-field__box">
    <Icon name="search" />
    <input
      class="search-field__input"
      type="search"
      placeholder="ابحث في الأذكار"
      aria-label="ابحث في الأذكار"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="search"
      data-search-input
    />
    <Button variant="icon" class="search-field__clear" aria-label="مسح" hidden data-search-clear>
      <Icon name="erase" />
    </Button>
    <kbd class="search-field__key" aria-hidden="true">
      Esc
    </kbd>
  </label>
  <Button variant="text" class="search-field__close" data-search-close>
    إلغاء
  </Button>
</div>
