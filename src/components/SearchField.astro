---
import Icon from './Icon.astro';

interface Props {
  variant?: 'page' | 'bar' | undefined;
}

const { variant = 'page' } = Astro.props;
---

<div class:list={['search-field', variant === 'bar' && 'search-field--bar']} data-search-only>
  <label class="search-field__box">
    <Icon name="search" />
    <input
      class="search-field__input"
      type="search"
      placeholder="ابحث في الأذكار"
      aria-label="ابحث في الأذكار"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="search"
      data-search-input
    />
    <button class="search-field__clear" type="button" aria-label="مسح" hidden data-search-clear>
      <span class="search-field__clear-face">
        <Icon name="close" />
      </span>
    </button>
  </label>
  {variant === 'bar' && (
    <button class="search-field__close" type="button" data-search-close>
      إلغاء
    </button>
  )}
</div>
