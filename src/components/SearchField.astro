---
import Icon from './Icon.astro';
---

<div class="search-field" data-search-only>
  <label class="search-field__box">
    <Icon name="search" />
    <input
      class="search-field__input"
      type="search"
      placeholder="ابحث في الأذكار"
      aria-label="ابحث في الأذكار"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="search"
      data-search-input
    />
    <button class="search-field__clear" type="button" aria-label="مسح" hidden data-search-clear>
      <Icon name="close" />
    </button>
  </label>
</div>
