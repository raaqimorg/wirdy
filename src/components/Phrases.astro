---
import { timesLabel, toArabicDigits } from '../lib/arabic';
import type { Phrase } from '../lib/phrases';

interface Props {
  phrases: Phrase[];
}

const { phrases } = Astro.props;
---

{
  phrases.map(({ text, count }) => (
    <span class="phrase">
      <span>{text}</span>
      <span class="phrase__count">
        <span aria-hidden="true">{toArabicDigits(count)}</span>
        <span class="vh">{timesLabel(count)}</span>
      </span>
    </span>
  ))
}
