---
import Button from './Button.astro';
import Emblem from './Emblem.astro';
import Icon from './Icon.astro';
import { Effect } from 'effect';
import { sectionTiles } from '../lib/collection';
import { GUIDE_IDS, type Guide } from '../lib/site';

const tiles = await Effect.runPromise(sectionTiles);
const here = Astro.url.pathname;
const isGuide = (id: string): id is Guide => GUIDE_IDS.some((guide) => guide === id);
const groups = [tiles.filter(({ id }) => !isGuide(id)), tiles.filter(({ id }) => isGuide(id))];
---

<div class="section-menu">
  <Button
    variant="icon"
    class="section-menu__button"
    aria-label="الأقسام"
    data-sheet-open="sections"
  >
    <Icon name="sections" />
  </Button>
  <dialog
    class="section-menu__panel"
    id="sections"
    aria-label="الأقسام"
    data-sheet
    data-expandable
    autofocus
  >
    <div class="section-menu__head" data-sheet-handle>
      <span class="section-menu__grabber" aria-hidden="true" />
      <p class="section-menu__title">الأقسام</p>
      <Button variant="icon" class="section-menu__close" aria-label="إغلاق" data-sheet-close>
        <Icon name="close" />
      </Button>
    </div>
    <ul class="section-menu__body">
      {groups.map((group) => (
        <li class="section-menu__group">
          <ul>
            {group.map(({ id, heading, color, href }) => (
              <li>
                <a
                  class="section-menu__link tone"
                  href={href}
                  style={`--tone: ${color}`}
                  aria-current={href === here ? 'page' : undefined}
                  data-hover="fill"
                >
                  <span class="section-menu__tile">
                    <Emblem name={id} motion="still" />
                  </span>
                  <span class="section-menu__label">{heading}</span>
                  {href === here && <Icon name="check" class="section-menu__check" />}
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </dialog>
</div>
