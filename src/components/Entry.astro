---
import Takhrij from './Takhrij.astro';
import type { Dhikr } from '../lib/schema';
import { takhrijLine } from '../lib/takhrij';

interface Props {
  takhrij: Dhikr['takhrij'];
  id?: string | undefined;
  title?: string | undefined;
  heading?: 'h2' | 'h3' | 'h4' | undefined;
  lead?: string | undefined;
  how?: string | undefined;
  fadl?: string | undefined;
  sound?: boolean | undefined;
  layout: 'split' | 'single';
  nested?: boolean | undefined;
  kind?: 'quran' | 'unproven' | undefined;
  time?: 'sabah' | 'masaa' | undefined;
}

const {
  takhrij,
  id,
  title,
  heading: Heading,
  lead,
  how,
  fadl,
  sound,
  layout,
  nested,
  kind,
  time,
} = Astro.props;
---

<li
  class:list={[
    'entry',
    `entry--${layout}`,
    nested && 'entry--nested',
    kind && `entry--${kind}`,
    time && `entry--${time}`,
  ]}
  id={id}
>
  {Heading && <Heading class="visually-hidden">{title}</Heading>}
  <div class="entry__main">
    {lead && (
      <div class="entry__head">
        <slot name="count" />
        <p class="entry__lead">
          <slot name="number" />
          {lead}
        </p>
        <slot name="badge" />
      </div>
    )}
    {how && <p class="entry__how">{how}</p>}
    <div class="entry__text">
      <slot />
    </div>
  </div>
  <div class="entry__side">
    <dl class="entry__info">
      {fadl && (
        <div class="entry__row">
          <dt>الفضل</dt>
          <dd class="entry__words">{fadl}</dd>
        </div>
      )}
      {sound && (
        <div class="entry__row entry__row--sound">
          <dt>تنبيه</dt>
          <dd class="entry__words">
            <slot name="sound" />
          </dd>
        </div>
      )}
      <div class="entry__row">
        <dt>التخريج</dt>
        <dd>
          <Takhrij href={takhrij.url} text={takhrijLine(takhrij)} />
        </dd>
      </div>
      {kind === 'quran' && (
        <div class="entry__row">
          <dt>النص</dt>
          <dd>
            <Takhrij href="https://tanzil.net/" text="موقع تنزيل" />
          </dd>
        </div>
      )}
    </dl>
    <slot name="actions" />
  </div>
</li>
