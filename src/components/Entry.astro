---
import Icon from './Icon.astro';
import Takhrij from './Takhrij.astro';
import type { Dhikr } from '../lib/schema';
import { takhrijLine } from '../lib/takhrij';

interface Props {
  takhrij: Dhikr['takhrij'];
  id?: string | undefined;
  title?: string | undefined;
  name?: string | undefined;
  heading?: 'h2' | 'h3' | 'h4' | undefined;
  count?: string | undefined;
  moment?: string | undefined;
  how?: string | undefined;
  rawi?: string | undefined;
  fadl?: string | undefined;
  single?: boolean | undefined;
  nested?: boolean | undefined;
  kind?: 'quran' | undefined;
  phrases?: boolean | undefined;
  time?: 'sabah' | 'masaa' | undefined;
}

const {
  takhrij,
  id,
  title,
  name,
  heading: Heading,
  count,
  moment,
  how,
  rawi,
  fadl,
  single,
  nested,
  kind,
  phrases,
  time,
} = Astro.props;
const Fold = single ? Fragment : 'details';
const fold = single ? {} : { class: 'entry__more' };
---

<li
  class:list={[
    'entry',
    single && 'entry--single',
    nested && 'entry--nested',
    kind && `entry--${kind}`,
    phrases && 'entry--phrases',
    time && `entry--${time}`,
  ]}
  id={id}
>
  <div class="entry__main">
    {Heading && name === undefined && <Heading class="visually-hidden">{title}</Heading>}
    {Heading && name !== undefined && (
      <Heading class="entry__name">
        {name}
        {title !== undefined && title.startsWith(name) && title !== name && (
          <span class="visually-hidden">{title.slice(name.length)}</span>
        )}
      </Heading>
    )}
    {(count || moment) && (
      <p class="entry__lead">
        {count && <span class="entry__count">{count}</span>}
        {count && moment && '، '}
        {moment}
      </p>
    )}
    {how && <p class="entry__how">{how}</p>}
    {rawi && <p class="entry__rawi">{rawi}</p>}
    <div class="entry__text">
      <slot />
    </div>
  </div>
  <Fold {...fold}>
    {!single && (
      <summary class="entry__toggle" data-hover="line">
        <span class="entry__toggle-closed">التخريج</span>
        <span class="entry__toggle-open">إخفاء</span>
        <Icon name="chevron" />
      </summary>
    )}
    <div class="entry__side">
      <dl class="entry__info">
        {fadl && (
          <div class="entry__row">
            <dt>الفضل</dt>
            <dd class="entry__words">{fadl}</dd>
          </div>
        )}
        <div class="entry__row">
          <dt>التخريج</dt>
          <dd>
            <Takhrij href={takhrij.url} text={takhrijLine(takhrij)} />
          </dd>
        </div>
        {kind === 'quran' && (
          <div class="entry__row">
            <dt>النص</dt>
            <dd>
              <Takhrij href="https://tanzil.net/" text="موقع تنزيل" />
            </dd>
          </div>
        )}
      </dl>
      {!single && <slot name="actions" />}
    </div>
  </Fold>
</li>
