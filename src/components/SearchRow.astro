---
import type { SearchRow } from '../lib/collection';

interface Props {
  row: SearchRow;
}

const { title, words, also, about, heading, color, emblem, group, quran, href } = Astro.props.row;
---

<li
  class:list={['search-row', quran && 'search-row--quran']}
  data-search-row
  data-search-section={emblem}
>
  <a class="search-row__link tone" href={href} style={`--tone: ${color}`} data-hover="fill">
    <span class="search-row__title" data-search-title>
      {title}
    </span>
    <span class="search-row__place" data-search-place>
      <span class="visually-hidden" data-search-where>
        {group ? `${heading}، ${group}` : heading}
      </span>
    </span>
    <span class="search-row__words" data-search-words data-also={also} data-about={about}>
      {words}
    </span>
  </a>
</li>
