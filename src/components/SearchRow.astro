---
import type { SearchRow } from '../lib/collection';

interface Props {
  row: SearchRow;
}

const { title, words, also, heading, color, group, ruling, href } = Astro.props.row;
---

<li class="search-row" data-search-row>
  <a class="search-row__link tone" href={href} style={`--tone: ${color}`}>
    <span class="search-row__title" data-search-title>
      {title}
    </span>
    <span class="search-row__words" data-search-words data-also={also}>
      {words}
    </span>
    <span class="search-row__place" data-search-place>
      <span class="search-row__dot"></span>
      {group ? `${heading} · ${group}` : heading}
      {ruling && (
        <Fragment>
          {' '}
          <span class="search-row__ruling">{ruling}</span>
        </Fragment>
      )}
    </span>
  </a>
</li>
