---
interface Props {
  links: { label: string; title: string; context?: string | undefined; href: string }[];
}

const { links } = Astro.props;
---

<nav class="neighbours" aria-label="السابق والتالي">
  {links.map(({ label, title, context, href }) => (
    <a class="neighbours__link" href={href}>
      <span class="neighbours__label">{label}</span>
      <span>
        {title}
        {context && (
          <Fragment>
            {' '}
            <span class="neighbours__context">{context}</span>
          </Fragment>
        )}
      </span>
    </a>
  ))}
</nav>
