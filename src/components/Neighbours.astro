---
interface Props {
  links: { label: string; title: string; href: string }[];
}

const { links } = Astro.props;
---

<nav class="neighbours" aria-label="التالي والسابق">
  {links.map(({ label, title, href }) => (
    <a class="neighbours__link" href={href}>
      <span class="neighbours__label">{label}</span>
      <span>{title}</span>
    </a>
  ))}
</nav>
