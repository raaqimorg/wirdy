---
import { EMBLEMS } from '../lib/emblems';
import type { EmblemName } from '../lib/emblems';

interface Props {
  occasion: EmblemName;
}

const { occasion } = Astro.props;
---

<svg class="emblem" viewBox="0 0 240 240" aria-hidden="true">
  {
    EMBLEMS[occasion].map(({ tag: Tag, attrs, order, enter }) => (
      <Tag {...attrs} data-enter={enter} style={`--o: ${order}`} />
    ))
  }
</svg>
