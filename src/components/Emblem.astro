---
import { EMBLEMS, type EmblemName } from '../lib/emblems';

interface Props {
  name: EmblemName;
  motion?: 'live' | 'still' | undefined;
  class?: string | undefined;
}

const { name, motion = 'live', class: className } = Astro.props;
---

<svg
  class:list={['emblem', className]}
  viewBox="0 0 240 240"
  aria-hidden="true"
  data-live={motion === 'live' ? '' : undefined}
>
  {EMBLEMS[name].map(({ tag: Tag, attrs, enter }) => (
    <Tag {...attrs} data-enter={enter} />
  ))}
</svg>
