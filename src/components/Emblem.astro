---
import { EMBLEMS, type EmblemName } from '../lib/emblems';

interface Props {
  name: EmblemName;
  motion?: 'always' | 'wide-only' | 'still' | undefined;
  class?: string | undefined;
}

const { name, motion = 'always', class: className } = Astro.props;
---

<svg
  class:list={['emblem', motion !== 'always' && `emblem--${motion}`, className]}
  viewBox="0 0 240 240"
  aria-hidden="true"
>
  {EMBLEMS[name].map(({ tag: Tag, attrs, enter }) => (
    <Tag {...attrs} data-enter={enter} />
  ))}
</svg>
