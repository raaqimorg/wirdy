---
import { pairWords } from '../lib/variants';

interface Props {
  now: string;
  other: string;
}

const { now, other } = Astro.props;
const NBSP = ' ';
const words = pairWords(now, other);
---

{words.map(({ word, alt }, i) => (
  <Fragment>
    {i > 0 && ' '}
    {alt ? (
      <span>
        {word}
        {NBSP}
        <span class="word-form__other" aria-hidden="true">
          {alt.replaceAll(' ', NBSP)}
        </span>
      </span>
    ) : (
      word
    )}
  </Fragment>
))}
