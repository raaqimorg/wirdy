---
interface Props {
  variant?: 'plain' | 'primary' | undefined;
  href?: string | undefined;
  [attribute: string]: unknown;
}

const { variant = 'plain', href, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const classes = variant === 'primary' ? 'button button--primary' : 'button';
---

<Tag class={classes} href={href} type={href ? undefined : 'button'} {...rest}>
  <slot />
</Tag>
