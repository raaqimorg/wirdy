---
interface Props {
  variant?: 'plain' | 'primary' | 'text' | 'icon' | undefined;
  href?: string | undefined;
  class?: string | undefined;
  [attribute: string]: unknown;
}

const { variant = 'plain', href, class: extra, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['button', variant !== 'plain' && `button--${variant}`, extra]}
  href={href}
  type={href ? undefined : 'button'}
  {...rest}
>
  <slot />
</Tag>
