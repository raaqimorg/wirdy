---
import Emblem from './Emblem.astro';
import Icon from './Icon.astro';
import type { EmblemName } from '../lib/emblems';

interface Props {
  title: string;
  evening?: string | undefined;
  lede: string;
  kicker?: string | undefined;
  eveningKicker?: string | undefined;
  up?: { href: string; label: string } | undefined;
  emblem?: EmblemName | undefined;
  turns?: boolean | undefined;
}

const { title, evening, lede, kicker, eveningKicker, up, emblem, turns = false } = Astro.props;
const long = title.length > 24;
---

<header
  class:list={[
    'banner',
    emblem ? 'banner--stage' : 'banner--plain',
    long && 'banner--long',
    turns && 'banner--turns',
  ]}
>
  <div class="banner__inner container">
    <div class="banner__words">
      {up ? (
        <nav class="banner__kicker" aria-label="مسار الصفحة">
          <a class="banner__up" href={up.href}>
            <Icon name="back" />
            <span class="banner__up-label">{up.label}</span>
          </a>
        </nav>
      ) : (
        <p class="banner__kicker">
          {eveningKicker ? (
            <Fragment>
              <span class="variant-text variant-text--sabah">{kicker}</span>
              <span class="variant-text variant-text--masaa">{eveningKicker}</span>
            </Fragment>
          ) : (
            kicker
          )}
        </p>
      )}
      <h1 class="banner__title">
        {evening ? (
          <Fragment>
            <span class="variant-text variant-text--sabah">{title}</span>
            <span class="variant-text variant-text--masaa">{evening}</span>
          </Fragment>
        ) : (
          title
        )}
      </h1>
      <p class="banner__lede">{lede}</p>
    </div>
    {emblem && (
      <div class="banner__graphic">
        <Emblem name={emblem} />
      </div>
    )}
  </div>
</header>
