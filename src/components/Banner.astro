---
import Emblem from './Emblem.astro';
import type { EmblemName } from '../lib/emblems';

interface Props {
  emblem: EmblemName;
  title: string;
  context?: string | undefined;
  lede?: string | undefined;
  single?: boolean | undefined;
}

const { emblem, title, context, lede, single = false } = Astro.props;
---

<header class:list={['banner', single && 'banner--single']}>
  <div class="banner__inner">
    <div class="banner__words">
      <h1 class="banner__title">
        {title}
        {context && (
          <Fragment>
            {' '}
            <span class="banner__context">{context}</span>
          </Fragment>
        )}
      </h1>
      {lede && <p class="banner__lede">{lede}</p>}
      <slot />
    </div>
    <div class="banner__graphic">
      <Emblem name={emblem} />
    </div>
  </div>
</header>
