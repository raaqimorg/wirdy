---
import Emblem from './Emblem.astro';
import type { EmblemName } from '../lib/emblems';

interface Props {
  emblem: EmblemName;
  title: string;
  lede?: string;
  single?: boolean;
}

const { emblem, title, lede, single = false } = Astro.props;
---

<header class:list={['banner', single && 'banner--single']}>
  <div class="banner__inner">
    <div class="banner__words">
      <h1 class="banner__title">{title}</h1>
      {lede && <p class="banner__lede">{lede}</p>}
      <slot />
    </div>
    <div class="banner__graphic">
      <Emblem name={emblem} />
    </div>
  </div>
</header>
