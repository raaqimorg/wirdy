---
import WordForm from './WordForm.astro';
import { Effect } from 'effect';
import { parseVariants } from '../lib/variants';

interface Props {
  text: string;
}

const { text } = Astro.props;
const segments = Effect.runSync(parseVariants(text));
---

{segments.map((segment) =>
  segment.type === 'text' ? (
    segment.value
  ) : (
    <Fragment>
      <span class="variant-text variant-text--sabah">
        <WordForm now={segment.sabah} other={segment.masaa} />
      </span>
      <span class="variant-text variant-text--masaa">
        <WordForm now={segment.masaa} other={segment.sabah} />
      </span>
    </Fragment>
  )
)}
