---
import { Effect } from 'effect';
import { parseVariants } from '../lib/variants';

interface Props {
  text: string;
}

const { text } = Astro.props;
const segments = Effect.runSync(parseVariants(text));
---

{segments.map((segment) =>
  segment.type === 'text' ? (
    segment.value
  ) : (
    <Fragment>
      <span class="variant-text variant-text--sabah">{segment.sabah}</span>
      <span class="variant-text variant-text--masaa">{segment.masaa}</span>
    </Fragment>
  )
)}
