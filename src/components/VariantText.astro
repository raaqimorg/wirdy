---
import WordForm from './WordForm.astro';
import { parseVariants } from '../lib/variants';

interface Props {
  text: string;
}

const { text } = Astro.props;
const segments = parseVariants(text);
---

{
  segments.map((segment) =>
    segment.type === 'text' ? (
      segment.value
    ) : (
      <Fragment><span class="v-s"><WordForm now={segment.sabah} other={segment.masaa} /></span><span class="v-m"><WordForm now={segment.masaa} other={segment.sabah} /></span></Fragment>
    ),
  )
}
