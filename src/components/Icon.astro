---
import { ICON_GRID, ICONS, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string | undefined;
}

const { name, class: className } = Astro.props;
const { paths } = ICONS[name];
---

<svg
  class:list={['icon', 'icon--line', className]}
  viewBox={`0 0 ${ICON_GRID} ${ICON_GRID}`}
  aria-hidden="true"
>
  {paths.map((d) => (
    <path d={d} />
  ))}
</svg>
