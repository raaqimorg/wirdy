---
import { ICONS, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const { size, stroke, paths, disc } = ICONS[name];
---

<svg
  class:list={['icon', stroke && 'icon--line', className]}
  viewBox={`0 0 ${size} ${size}`}
  stroke-width={stroke}
  aria-hidden="true"
>
  {disc && <circle cx={size / 2} cy={size / 2} r={disc} />}
  {paths.map((d) => (
    <path d={d} />
  ))}
</svg>
