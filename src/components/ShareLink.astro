---
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  href: string;
  title: string;
  variant: 'icon' | 'button';
}

const { href, title, variant } = Astro.props;
---

{variant === 'icon' ? (
  <Fragment>
    <span class="share-link__status share-link__status--over" role="status" data-share-status />
    <a class="share-link" href={href} data-share-title={title} aria-label={`مشاركة: ${title}`}>
      <Icon name="share" />
    </a>
  </Fragment>
) : (
  <Fragment>
    <span class="share-link__status share-link__status--under" role="status" data-share-status />
    <Button href={href} variant="primary" data-share-title={title}>
      <Icon name="share" />
      مشاركة
    </Button>
  </Fragment>
)}
