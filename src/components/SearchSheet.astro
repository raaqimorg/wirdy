---
import Search from './Search.astro';
import { Effect } from 'effect';
import { searchIndex } from '../lib/collection';

interface Props {
  stage?: boolean | undefined;
}

const { stage = false } = Astro.props;
const { path } = await Effect.runPromise(searchIndex);
---

<dialog
  class:list={['search-sheet', stage && 'search-sheet--stage']}
  aria-label="البحث"
  data-search-sheet
  data-search-index={path}
>
  <Search />
</dialog>

<script>
  import { Effect } from 'effect';
  import { mountSheet } from '../scripts/search';

  const sheet = document.querySelector('[data-search-sheet]');
  if (sheet instanceof HTMLDialogElement) Effect.runSync(mountSheet(sheet));
</script>
