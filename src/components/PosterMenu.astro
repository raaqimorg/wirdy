---
import Button from './Button.astro';
import Icon from './Icon.astro';
import {
  FORMATS,
  posterDownload,
  posterFile,
  THEME_TITLES,
  themesOf,
  type Poster,
  type ThemeName,
} from '../lib/poster';

interface Props {
  posters: ReadonlyArray<Poster>;
}

const { posters } = Astro.props;

const files = Object.fromEntries(
  posters.map((poster) => [
    poster.form === 'masaa' ? 'm' : 's',
    Object.fromEntries(
      FORMATS.flatMap((format) =>
        themesOf(format).map((theme) => [
          `${format.name}-${theme}`,
          [`/${posterFile(poster, format, theme)}`, posterDownload(poster, format, theme)],
        ])
      )
    ),
  ])
);
const [first] = posters;
const [story] = FORMATS;
const themes: ReadonlyArray<ThemeName> = ['light', 'dark'];
---

{first && story && (
  <div class="poster-menu" data-poster-menu data-posters={JSON.stringify(files)}>
    <Button
      variant="icon"
      class="poster-menu__button"
      aria-label="صورة للمشاركة"
      data-sheet-open="posters"
    >
      <Icon name="share" />
    </Button>
    <dialog class="poster-menu__panel" id="posters" aria-label="صورة للمشاركة" data-sheet autofocus>
      <div class="poster-menu__head" data-sheet-handle>
        <span class="poster-menu__grabber" aria-hidden="true" />
        <p class="poster-menu__title">صورة للمشاركة</p>
        <Button variant="icon" class="poster-menu__close" aria-label="إغلاق" data-sheet-close>
          <Icon name="close" />
        </Button>
      </div>
      <div class="poster-menu__body">
        <p class="poster-menu__heading" id="poster-format">
          الشكل
        </p>
        <div class="poster-menu__group" role="radiogroup" aria-labelledby="poster-format">
          {FORMATS.map((format) => (
            <button
              class="poster-menu__option"
              type="button"
              aria-checked={format === story ? 'true' : 'false'}
              role="radio"
              data-poster-format={format.name}
              data-hover="fill"
            >
              <Icon name="check" class="poster-menu__check" />
              <span class="poster-menu__name">{format.title}</span>
              <span class={`poster-menu__shape poster-menu__shape--${format.name}`} />
            </button>
          ))}
        </div>
        <p class="poster-menu__heading" id="poster-theme">
          اللون
        </p>
        <div class="poster-menu__group" role="radiogroup" aria-labelledby="poster-theme">
          {themes.map((theme) => (
            <button
              class="poster-menu__option"
              type="button"
              aria-checked={theme === 'light' ? 'true' : 'false'}
              role="radio"
              data-poster-theme={theme}
              data-hover="fill"
            >
              <Icon name="check" class="poster-menu__check" />
              <span class="poster-menu__name">
                {THEME_TITLES[theme]}
                {theme === 'dark' && <span class="poster-menu__note">الطباعة فاتحة دائما</span>}
              </span>
            </button>
          ))}
        </div>
      </div>
      <div class="poster-menu__foot">
        <span class="visually-hidden" role="status" data-status />
        <a
          class="poster-menu__save"
          href={`/${posterFile(first, story, 'light')}`}
          download={posterDownload(first, story, 'light')}
          data-poster-save
          data-hover="fill"
        >
          <Icon name="save" class="poster-menu__icon icon--idle" />
          <Icon name="check" class="poster-menu__icon icon--done" />
          <span data-label>حفظ الصورة</span>
        </a>
      </div>
    </dialog>
  </div>
)}
