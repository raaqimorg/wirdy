---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { Option } from 'effect';
import type { Copy } from '../lib/copy';

interface Props {
  href: string;
  title: string;
  image: string;
  file: string;
  copy: Copy;
}

const { href, title, image, file, copy } = Astro.props;
---

<p class="dhikr-actions">
  <span class="dhikr-actions__status" role="status" data-status></span>
  <Button href={href} variant="primary" data-share-title={title}>
    <Icon name="share" />
    مشاركة
  </Button>
  <Button data-copy={copy.sabah} data-copy-masaa={Option.getOrUndefined(copy.masaa)}>
    <Icon name="copy" />
    نسخ
  </Button>
  <Button href={image} download={file}>
    <Icon name="save" />
    الصورة
  </Button>
</p>
