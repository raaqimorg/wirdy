---
import { beadRing } from '../lib/beads';

interface Props {
  count: number;
}

const { beads, label } = beadRing(Astro.props.count);
---

<svg
  class:list={['bead-ring', beads.length === 0 && 'bead-ring--full']}
  viewBox="0 0 32 32"
  aria-hidden="true"
>
  <circle class="bead-ring__string" cx="16" cy="16" r="13"></circle>
  {beads.map(({ cx, cy }) => (
    <circle cx={cx} cy={cy} r="2.2" />
  ))}
  <text class="bead-ring__count" x="16" y="16">
    {label}
  </text>
</svg>
