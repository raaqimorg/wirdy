---
import OccasionCard from './OccasionCard.astro';
import type { Tile } from '../lib/collection';
import { widthsOf } from '../lib/grid';

interface Props {
  tiles: ReadonlyArray<Tile>;
  variant: 'featured' | 'compact';
  lead?: boolean | undefined;
}

const { tiles, variant, lead = true } = Astro.props;

const widths = widthsOf(tiles.length);

const motion = variant === 'featured' && lead ? 'live' : 'still';
const cardOf = (index: number) => {
  if (variant !== 'featured') return 'compact';
  return lead && index === 0 ? 'lead' : 'row';
};
const wide = (index: number) => variant === 'featured' && widths[index] === 'wide';
---

<ul class={`card-grid card-grid--${variant}`}>
  {tiles.map((tile, index) => (
    <li class:list={[wide(index) && 'card-grid__wide']}>
      <OccasionCard tile={tile} variant={cardOf(index)} motion={motion} />
    </li>
  ))}
</ul>
