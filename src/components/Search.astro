---
import CardGrid from './CardGrid.astro';
import Emblem from './Emblem.astro';
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import SearchField from './SearchField.astro';
import SearchHead from './SearchHead.astro';
import SearchRow from './SearchRow.astro';
import type { SearchRow as Row, Tile } from '../lib/collection';
import type { EmblemName } from '../lib/emblems';
import { OCCASIONS } from '../lib/occasions';
import { TIBB } from '../lib/site';

interface Props {
  tiles?: ReadonlyArray<Tile> | undefined;
  rows?: ReadonlyArray<Row> | undefined;
  sheet?: boolean | undefined;
}

const { tiles, rows = [], sheet = false } = Astro.props;
const sections: { id: EmblemName; heading: string; color: string }[] = [
  ...OCCASIONS,
  { id: 'tibb', heading: TIBB.heading, color: TIBB.color },
];
const tries = ['السفر', 'الاستخارة', 'الكرب', 'النوم', 'العافية', 'سيد الاستغفار'];
const blank: Row = {
  title: '',
  words: '',
  heading: '',
  color: '',
  emblem: 'tibb',
  href: '/',
};
---

<div class:list={['search', sheet && 'search--sheet']} data-search>
  <SearchField variant={sheet ? 'bar' : 'page'} />
  <div class="search__body">
    <section class="search__recent" hidden data-search-recent>
      <div class="search__recent-head">
        <h2 class="search__subtitle">آخر ما فتحت</h2>
        <button class="search__forget" type="button" data-search-forget>
          مسح السجل
        </button>
      </div>
      <ul class="search__list" data-search-recent-list></ul>
    </section>
    <div data-search-browse>
      <h2 class="search__subtitle">اقتراحات</h2>
      <ul class="search__tries">
        {tries.map((word) => (
          <li>
            <button class="search__try" type="button" data-search-try>
              <Icon name="search" />
              <span class="search__try-word">{word}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
    <p class="visually-hidden" role="status" data-search-status></p>
    <div class="search__empty" role="status" hidden data-search-empty>
      <Mark />
      <p class="search__empty-title">
        لا نتائج لـ «<bdi data-search-query></bdi>»
      </p>
      <p>جرّب كلمة من أول الذكر، أو كلمة أقصر</p>
    </div>
    <p class="search__note" hidden data-search-note>
      لا نتائج لكل الكلمات معًا، وهذه نتائج «<bdi data-search-note-word></bdi>»
    </p>
    {tiles && (
      <section class="search__browse" data-search-browse>
        <h2 class="search__subtitle">تصفّح الأقسام</h2>
        <CardGrid tiles={tiles} variant="featured" />
      </section>
    )}
    <ul class="search__list" hidden data-search-list>
      {rows.map((row) => (
        <SearchRow row={row} />
      ))}
    </ul>
  </div>
  {sections.map(({ id, heading, color }) => (
    <template data-search-section-head={id}>
      <SearchHead heading={heading} color={color}>
        <Emblem name={id} motion="still" />
      </SearchHead>
    </template>
  ))}
  {sheet && (
    <template data-search-template>
      <SearchRow row={blank} />
    </template>
  )}
</div>
