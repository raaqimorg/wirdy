---
import naskh from '@fontsource/amiri/files/amiri-arabic-400-normal.woff2?url';
import quran from '@fontsource/amiri-quran/files/amiri-quran-arabic-400-normal.woff2?url';
import plex400 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url';
import plex500 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-500-normal.woff2?url';
import plex700 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-700-normal.woff2?url';
import '../styles/index.css';
import SearchSheet from '../components/SearchSheet.astro';
import SkipLink from '../components/SkipLink.astro';
import { PALETTE } from '../lib/palette';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string | undefined;
  imageSize?: [width: number, height: number] | undefined;
  crumbs?: { name: string; path: string }[] | undefined;
  noindex?: boolean | undefined;
  faces?: ('naskh' | 'quran')[] | undefined;
  tone?: string | undefined;
  search?: boolean | undefined;
}

const {
  title: topic,
  description,
  image = '/opengraph.png',
  imageSize: [imageWidth, imageHeight] = [2400, 1260],
  crumbs = [],
  noindex = false,
  faces = ['naskh'],
  tone,
  search = true,
} = Astro.props;
const FACES = { naskh, quran };
const preloads = [plex400, plex500, plex700, ...faces.map((face) => FACES[face])];

const siteName = SITE.name;
const title = `${topic} | ${siteName}`;

const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const siteUrl = new URL('/', Astro.site).href;
const siteId = new URL('/#website', Astro.site).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': siteId,
      url: siteUrl,
      name: siteName,
      alternateName: SITE.title,
      description: SITE.description,
      inLanguage: 'ar',
    },
    {
      '@type': 'WebPage',
      '@id': pageUrl.href,
      url: pageUrl.href,
      name: title,
      description,
      inLanguage: 'ar',
      isPartOf: { '@id': siteId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImage.href,
        width: imageWidth,
        height: imageHeight,
      },
    },
    ...(crumbs.length > 0
      ? [
          {
            '@type': 'BreadcrumbList',
            itemListElement: [{ name: siteName, path: '/' }, ...crumbs].map(
              ({ name, path }, index) => ({
                '@type': 'ListItem',
                position: index + 1,
                name,
                item: new URL(path, Astro.site).href,
              })
            ),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {preloads.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={pageUrl.href} />
    )}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={PALETTE.paperDark} />
    <meta name="theme-color" content={PALETTE.paper} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={title} />

    {!noindex && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    )}
    <script is:inline>
      (function () {
        const root = document.documentElement;
        function period() {
          const hour = new Date().getHours();
          return hour < 12 ? 's' : 'm';
        }
        function kept() {
          try {
            const saved = sessionStorage.getItem('wird') || '';
            return saved[0] === period() ? saved[1] : null;
          } catch (error) {
            return null;
          }
        }
        function mark() {
          const forms = document.querySelectorAll('[data-wird-form]');
          for (let i = 0; i < forms.length; i += 1) {
            if (forms[i].dataset.wirdForm === root.dataset.wird)
              forms[i].setAttribute('aria-current', 'true');
            else forms[i].removeAttribute('aria-current');
          }
        }
        function choose(form) {
          root.dataset.wird = form;
          try {
            sessionStorage.setItem('wird', period() + form);
          } catch (error) {}
          mark();
        }
        const override = location.search.match(/w=([sm])/u);
        if (override) choose(override[1]);
        else root.dataset.wird = kept() || period();
        document.addEventListener('DOMContentLoaded', mark);
        window.addEventListener('pageshow', function (event) {
          if (!event.persisted) return;
          root.dataset.wird = kept() || period();
          mark();
        });
        document.addEventListener('touchstart', function () {}, { passive: true });

        const metas = document.querySelectorAll('meta[name="theme-color"]');
        const paper = {};
        for (let i = 0; i < metas.length; i += 1)
          paper[metas[i].media ? 'dark' : 'light'] = metas[i].content;
        const device = matchMedia('(prefers-color-scheme: dark)');
        function deviceTheme() {
          return device.matches ? 'dark' : 'light';
        }
        function current() {
          return root.dataset.theme || deviceTheme();
        }
        function apply(theme) {
          if (theme) root.dataset.theme = theme;
          else delete root.dataset.theme;
          for (let j = 0; j < metas.length; j += 1) {
            metas[j].content = paper[theme || (metas[j].media ? 'dark' : 'light')];
          }
        }
        function announce() {
          const buttons = document.querySelectorAll('[data-theme-toggle]');
          for (let k = 0; k < buttons.length; k += 1)
            buttons[k].setAttribute('aria-pressed', String(current() === 'dark'));
        }
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') apply(saved);
        } catch (error) {}
        document.addEventListener('DOMContentLoaded', announce);
        device.addEventListener('change', announce);
        document.addEventListener('click', function (event) {
          if (!event.target.closest('[data-theme-toggle]')) return;
          const next = current() === 'dark' ? 'light' : 'dark';
          const follow = next === deviceTheme();
          apply(follow ? null : next);
          try {
            if (follow) localStorage.removeItem('theme');
            else localStorage.setItem('theme', next);
          } catch (error) {}
          announce();
        });

        function say(from, words) {
          const said = from.parentElement.querySelector('[data-status]');
          said.textContent = words;
          clearTimeout(said.clearing);
          said.clearing = setTimeout(function () {
            said.textContent = '';
          }, 2500);
        }
        document.addEventListener('click', function (event) {
          const form = event.target.closest('[data-wird-form]');
          if (form && !event.metaKey && !event.ctrlKey && !event.shiftKey) {
            event.preventDefault();
            choose(form.dataset.wirdForm);
            if (location.search) history.replaceState(null, '', location.pathname + location.hash);
          }
          const copy = event.target.closest('[data-copy]');
          if (copy) {
            const evening = root.dataset.wird === 'm' && copy.dataset.copyMasaa;
            const done = navigator.clipboard
              ? navigator.clipboard.writeText(evening || copy.dataset.copy)
              : Promise.reject(new Error('no clipboard'));
            done.then(
              function () {
                return say(copy, 'نُسخ الذكر');
              },
              function () {
                say(copy, 'تعذّر النسخ');
              }
            );
          }
          const share = event.target.closest('[data-share-title]');
          if (!share || event.metaKey || event.ctrlKey || event.shiftKey) return;
          const url = share.href;
          if (navigator.share) {
            event.preventDefault();
            navigator.share({ title: share.dataset.shareTitle, url: url }).catch(function () {});
          } else if (navigator.clipboard) {
            event.preventDefault();
            navigator.clipboard.writeText(url).then(
              function () {
                return say(share, 'نُسخ الرابط');
              },
              function () {
                location.href = url;
              }
            );
          }
        });
      })();
    </script>
    <noscript>
      <style>
        [data-theme-toggle],
        [data-wird-switch],
        [data-copy],
        [data-search-only] {
          display: none !important;
        }
        [data-search-list] {
          display: block !important;
        }
      </style>
    </noscript>
  </head>
  <body class={tone && 'tone'} style={tone && `--tone: ${tone}`}>
    <SkipLink />
    <slot />
    {search && <SearchSheet stage={Boolean(tone)} />}
  </body>
</html>
