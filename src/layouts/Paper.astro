---
import plex400 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url';
import plex500 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-500-normal.woff2?url';
import plex700 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-700-normal.woff2?url';
import quran from '../fonts/kfgqpc-hafs.ttf?url';
import naskh from '../fonts/kfgqpc-naskh-regular.ttf?url';
import '../styles/index.css';
import SearchSheet from '../components/SearchSheet.astro';
import SkipLink from '../components/SkipLink.astro';
import { homeCardFile } from '../lib/card';
import { ICON_VERSION } from '../lib/mark';
import { PALETTE } from '../lib/palette';
import { RAAQIM, SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string | undefined;
  imageSize?: [width: number, height: number] | undefined;
  crumbs?: { name: string; path: string }[] | undefined;
  canonical?: string | undefined;
  noindex?: boolean | undefined;
  faces?: ('naskh' | 'quran')[] | undefined;
  tone?: string | undefined;
}

const {
  title: topic,
  description,
  image = `/${homeCardFile()}`,
  imageSize: [imageWidth, imageHeight] = [2400, 1260],
  crumbs = [],
  canonical = Astro.url.pathname,
  noindex = false,
  faces = ['naskh'],
  tone,
} = Astro.props;
const FACES = { naskh, quran };
const preloads = [plex400, plex500, plex700, ...faces.map((face) => FACES[face])];

const siteName = SITE.name;
const title = `${topic} | ${siteName}`;

const pageUrl = new URL(canonical, Astro.site);
const ogImage = new URL(image, Astro.site);
const siteUrl = new URL('/', Astro.site).href;
const siteId = new URL('/#website', Astro.site).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': siteId,
      url: siteUrl,
      name: siteName,
      alternateName: SITE.title,
      description: SITE.description,
      inLanguage: 'ar',
    },
    {
      '@type': 'WebPage',
      '@id': pageUrl.href,
      url: pageUrl.href,
      name: title,
      description,
      inLanguage: 'ar',
      isPartOf: { '@id': siteId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImage.href,
        width: imageWidth,
        height: imageHeight,
      },
    },
    ...(crumbs.length > 0
      ? [
          {
            '@type': 'BreadcrumbList',
            itemListElement: [{ name: siteName, path: '/' }, ...crumbs].map(
              ({ name, path }, index) => ({
                '@type': 'ListItem',
                position: index + 1,
                name,
                item: new URL(path, Astro.site).href,
              })
            ),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="ar" dir="rtl" translate="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="google" content="notranslate" />
    {preloads.map((href) => (
      <link
        rel="preload"
        href={href}
        as="font"
        type={href.endsWith('.ttf') ? 'font/ttf' : 'font/woff2'}
        crossorigin
      />
    ))}
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={pageUrl.href} />
    )}
    <link rel="icon" href={`/favicon.ico?v=${ICON_VERSION}`} sizes="any" />
    <link rel="icon" href={`/favicon.svg?v=${ICON_VERSION}`} type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href={`/favicon-32x32.png?v=${ICON_VERSION}`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon.png?v=${ICON_VERSION}`} />
    <link rel="manifest" href={`/site.webmanifest?v=${ICON_VERSION}`} />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={PALETTE.paperDark} />
    <meta name="theme-color" content={PALETTE.paper} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={RAAQIM.handle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={title} />

    {!noindex && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    )}
    <script is:inline>
      (function () {
        const root = document.documentElement;
        function period() {
          const hour = new Date().getHours();
          return hour < 12 ? 's' : 'm';
        }
        function kept() {
          try {
            const saved = sessionStorage.getItem('wird') || '';
            return saved[0] === period() ? saved[1] : null;
          } catch (error) {
            return null;
          }
        }
        function mark() {
          const forms = document.querySelectorAll('[data-wird-form]');
          for (let i = 0; i < forms.length; i += 1) {
            if (forms[i].dataset.wirdForm === root.dataset.wird)
              forms[i].setAttribute('aria-current', 'true');
            else forms[i].removeAttribute('aria-current');
          }
        }
        function choose(form) {
          root.dataset.wird = form;
          try {
            sessionStorage.setItem('wird', period() + form);
          } catch (error) {}
          mark();
        }
        const override = location.search.match(/w=([sm])/u);
        if (override) choose(override[1]);
        else root.dataset.wird = kept() || period();
        document.addEventListener('DOMContentLoaded', mark);
        window.addEventListener('pageshow', function (event) {
          if (!event.persisted) return;
          root.dataset.wird = kept() || period();
          mark();
        });
        document.addEventListener('touchstart', function () {}, { passive: true });
        const warmed = {};
        function warm(event) {
          const link = event.target.closest && event.target.closest('a[href^="/"]');
          const worker = navigator.serviceWorker && navigator.serviceWorker.controller;
          if (!link || !worker || link.pathname === location.pathname || warmed[link.pathname])
            return;
          warmed[link.pathname] = true;
          worker.postMessage({ keep: link.pathname }); // oxlint-disable-line unicorn/require-post-message-target-origin -- a service worker's postMessage takes no target origin
        }
        let hovering;
        document.addEventListener('pointerdown', warm, { passive: true });
        document.addEventListener('pointerover', function (event) {
          clearTimeout(hovering);
          if (event.pointerType === 'mouse')
            hovering = setTimeout(function () {
              warm(event);
            }, 65);
        });
        document.addEventListener('click', function (event) {
          if (root.dataset.searchReady === undefined && event.target.closest('[data-search-open]'))
            root.dataset.searchPending = '';
        });

        const metas = document.querySelectorAll('meta[name="theme-color"]');
        const paper = {};
        for (let i = 0; i < metas.length; i += 1)
          paper[metas[i].media ? 'dark' : 'light'] = metas[i].content;
        const device = matchMedia('(prefers-color-scheme: dark)');
        function deviceTheme() {
          return device.matches ? 'dark' : 'light';
        }
        function current() {
          return root.dataset.theme || deviceTheme();
        }
        function apply(theme) {
          if (theme) root.dataset.theme = theme;
          else delete root.dataset.theme;
          for (let j = 0; j < metas.length; j += 1) {
            metas[j].content = paper[theme || (metas[j].media ? 'dark' : 'light')];
          }
        }
        function announce() {
          const buttons = document.querySelectorAll('[data-theme-toggle]');
          for (let k = 0; k < buttons.length; k += 1)
            buttons[k].setAttribute('aria-pressed', String(current() === 'dark'));
        }
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') apply(saved);
        } catch (error) {}
        document.addEventListener('DOMContentLoaded', announce);
        device.addEventListener('change', announce);
        document.addEventListener('click', function (event) {
          if (!event.target.closest('[data-theme-toggle]')) return;
          const next = current() === 'dark' ? 'light' : 'dark';
          const follow = next === deviceTheme();
          apply(follow ? null : next);
          try {
            if (follow) localStorage.removeItem('theme');
            else localStorage.setItem('theme', next);
          } catch (error) {}
          announce();
        });

        const resetting = new WeakMap();
        function answer(button, words, state) {
          say(button, words);
          const { dataset } = button;
          const label = button.querySelector('[data-label]');
          if (label && dataset.rest === undefined) dataset.rest = label.textContent;
          if (label) label.textContent = words;
          dataset.copied = state;
          clearTimeout(resetting.get(button));
          resetting.set(
            button,
            setTimeout(function () {
              dataset.copied = 'no';
              if (label) label.textContent = dataset.rest;
            }, 2500)
          );
        }
        function copied(button, words) {
          answer(button, words, 'yes');
        }
        function say(from, words) {
          const said = from.parentElement.querySelector('[data-status]');
          said.textContent = words;
          clearTimeout(said.clearing);
          said.clearing = setTimeout(function () {
            said.textContent = '';
          }, 2500);
        }
        document.addEventListener('click', function (event) {
          const form = event.target.closest('[data-wird-form]');
          if (form && !event.metaKey && !event.ctrlKey && !event.shiftKey) {
            event.preventDefault();
            choose(form.dataset.wirdForm);
            if (location.search) history.replaceState(null, '', location.pathname + location.hash);
          }
          const copy = event.target.closest('[data-copy]');
          if (copy) {
            const evening = root.dataset.wird === 'm' && copy.dataset.copyMasaa;
            const done = navigator.clipboard
              ? navigator.clipboard.writeText(evening || copy.dataset.copy)
              : Promise.reject(new Error('no clipboard'));
            done.then(
              function () {
                return copied(copy, 'نسخ الذكر');
              },
              function () {
                answer(copy, 'تعذر النسخ', 'failed');
              }
            );
          }
          const share = event.target.closest('[data-share-title]');
          if (!share || event.metaKey || event.ctrlKey || event.shiftKey) return;
          const url = share.href;
          if (navigator.share) {
            event.preventDefault();
            navigator.share({ title: share.dataset.shareTitle, url: url }).catch(function () {});
          } else if (navigator.clipboard) {
            event.preventDefault();
            navigator.clipboard.writeText(url).then(
              function () {
                return copied(share, 'نسخ الرابط');
              },
              function () {
                location.href = url;
              }
            );
          }
        });

        const sharesFiles =
          matchMedia('(pointer: coarse)').matches &&
          Boolean(navigator.canShare) &&
          navigator.canShare({ files: [new File([''], 'x.png', { type: 'image/png' })] });
        const fetched = new Set();
        const ready = new Map();
        function pick(option) {
          const group = option.parentElement.children;
          for (let i = 0; i < group.length; i += 1) {
            group[i].setAttribute('aria-checked', String(group[i] === option));
          }
        }
        function check(option) {
          const menu = option.closest('[data-poster-menu]');
          pick(option);
          if (option.dataset.posterTheme) menu.dataset.chosen = '';
          posterOf(menu);
        }
        function posterOf(menu) {
          const format = menu.querySelector('[data-poster-format][aria-checked="true"]');
          const dark = menu.querySelector('[data-poster-theme="dark"]');
          dark.disabled = format.dataset.posterFormat === 'print';
          if (dark.disabled) pick(menu.querySelector('[data-poster-theme="light"]'));
          const theme = menu.querySelector('[data-poster-theme][aria-checked="true"]');
          const files = JSON.parse(menu.dataset.posters);
          const [href, name] = (files[root.dataset.wird] || files.s)[
            `${format.dataset.posterFormat}-${theme.dataset.posterTheme}`
          ];
          const link = menu.querySelector('[data-poster-save]');
          link.href = href;
          link.download = name;
          if (!sharesFiles || fetched.has(href)) return;
          fetched.add(href);
          fetch(href)
            .then(function (response) {
              if (!response.ok) throw new Error(String(response.status));
              return response.blob();
            })
            .then(
              function (blob) {
                return ready.set(href, new File([blob], name, { type: 'image/png' }));
              },
              function () {
                return fetched.delete(href);
              }
            );
        }
        function prepare(menu) {
          if (menu.dataset.chosen === undefined)
            pick(menu.querySelector(`[data-poster-theme="${current()}"]`));
          posterOf(menu);
        }
        document.addEventListener('click', function (event) {
          const menu = event.target.closest('[data-poster-menu]');
          if (!menu) return;
          const option = event.target.closest('[data-poster-format], [data-poster-theme]');
          if (option && !option.disabled) check(option);
          const link = event.target.closest('[data-poster-save]');
          if (!link) return;
          posterOf(menu);
          const file = ready.get(link.getAttribute('href'));
          if (!file) return;
          event.preventDefault();
          navigator.share({ files: [file] }).then(
            function () {
              return copied(link, 'تم');
            },
            function (error) {
              if (error.name !== 'AbortError') location.assign(link.href);
            }
          );
        });

        const wide = matchMedia('(min-width: 40rem)');
        const tallest = 'calc(100dvh - env(safe-area-inset-top) - var(--space-3))';
        let drag = null;
        function rest(sheet) {
          sheet.style.removeProperty('translate');
          sheet.style.removeProperty('max-height');
          sheet.style.removeProperty('height');
          sheet.toggleAttribute('data-dragging', false);
        }
        document.addEventListener('pointerdown', function (event) {
          const handle = event.target.closest('[data-sheet-handle]');
          if (!handle || event.pointerType === 'mouse' || wide.matches) return;
          if (event.target.closest('button')) return;
          const sheet = handle.closest('[data-sheet]');
          const height = sheet.offsetHeight;
          const expanded = sheet.dataset.size === 'expanded';
          const natural = Number(sheet.dataset.natural) || height;
          drag = {
            sheet: sheet,
            start: event.clientY,
            height: height,
            natural: natural,
            expanded: expanded,
            expandable: sheet.dataset.expandable !== undefined,
            shrinkable: expanded ? Math.max(0, height - natural) : 0,
            offset: 0,
          };
          sheet.dataset.dragging = '';
          handle.setPointerCapture(event.pointerId);
        });
        document.addEventListener('pointermove', function (event) {
          if (!drag) return;
          drag.offset = event.clientY - drag.start;
          const style = drag.sheet.style;
          if (drag.offset < 0) {
            style.translate = '';
            if (!drag.expandable) return;
            style.maxHeight = 'none';
            style.height = `min(${drag.height - drag.offset}px, ${tallest})`;
            return;
          }
          const shrink = Math.min(drag.offset, drag.shrinkable);
          style.height = shrink ? `${drag.height - shrink}px` : '';
          style.translate = `0 ${drag.offset - shrink}px`;
        });
        function settle() {
          if (!drag) return;
          const { sheet, offset, height, natural, expanded, expandable, shrinkable } = drag;
          drag = null;
          if (offset - shrinkable >= 80) {
            sheet.close();
            rest(sheet);
            return;
          }
          rest(sheet);
          if (expanded && offset > 0 && offset >= Math.min(80, shrinkable)) {
            sheet.style.height = `${natural}px`;
            delete sheet.dataset.size;
          } else if (expandable && !expanded && offset <= -60) {
            sheet.dataset.natural = String(height);
            sheet.dataset.size = 'expanded';
          }
        }
        document.addEventListener('pointerup', settle);
        document.addEventListener('pointercancel', settle);
        function outside(event, box) {
          return (
            event.clientX < box.left ||
            event.clientX > box.right ||
            event.clientY < box.top ||
            event.clientY > box.bottom
          );
        }
        document.addEventListener('click', function (event) {
          const opener = event.target.closest('[data-sheet-open]');
          if (opener) {
            const sheet = document.querySelector(`#${opener.dataset.sheetOpen}`);
            sheet.showModal();
            const menu = sheet.closest('[data-poster-menu]');
            if (menu) prepare(menu);
            return;
          }
          const sheet = event.target.closest('[data-sheet]');
          if (!sheet) return;
          if (event.target.closest('[data-sheet-close]')) sheet.close();
          else if (event.target === sheet && outside(event, sheet.getBoundingClientRect()))
            sheet.close();
        });
        document.addEventListener(
          'close',
          function (event) {
            const sheet = event.target;
            if (sheet.dataset.sheet === undefined) return;
            rest(sheet);
            delete sheet.dataset.size;
            delete sheet.dataset.natural;
          },
          true
        );
      })();
    </script>
    {import.meta.env.PROD ? (
      <script is:inline>
        if ('serviceWorker' in navigator)
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('/service-worker.js').catch(function () {});
          });
      </script>
    ) : (
      <script is:inline>
        if ('serviceWorker' in navigator)
          window.addEventListener('load', function () {
            navigator.serviceWorker.getRegistrations().then(function (registrations) {
              return Promise.all(
                registrations.map(function (registration) {
                  return registration.unregister();
                })
              );
            });
          });
      </script>
    )}
    <noscript>
      <style>
        [data-theme-toggle],
        [data-wird-switch],
        [data-copy],
        [data-search-open],
        [data-sheet-open] {
          display: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class={tone && 'tone'} style={tone && `--tone: ${tone}`}>
    <SkipLink />
    <slot />
    <SearchSheet stage={Boolean(tone)} />
  </body>
</html>
