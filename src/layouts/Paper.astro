---
import "@fontsource/amiri/arabic-400.css";
import "@fontsource/amiri-quran/arabic-400.css";
import "@fontsource/ibm-plex-sans-arabic/arabic-400.css";
import "@fontsource/ibm-plex-sans-arabic/arabic-500.css";
import "@fontsource/ibm-plex-sans-arabic/arabic-700.css";
import "../styles/paper.css";

import { SITE } from "../lib/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  section?: string;
  noindex?: boolean;
}

const { title, description, image = "/opengraph.png", section, noindex = false } = Astro.props;
const siteName = SITE.name;

const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const siteUrl = new URL("/", Astro.site).href;
const siteId = new URL("/#website", Astro.site).href;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": siteId,
      url: siteUrl,
      name: siteName,
      alternateName: SITE.title,
      description: SITE.description,
      inLanguage: "ar",
    },
    {
      "@type": "WebPage",
      "@id": pageUrl.href,
      url: pageUrl.href,
      name: title,
      description,
      inLanguage: "ar",
      isPartOf: { "@id": siteId },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: ogImage.href,
        width: 2400,
        height: 1260,
      },
    },
    ...(section
      ? [
          {
            "@type": "BreadcrumbList",
            itemListElement: [
              { "@type": "ListItem", position: 1, name: siteName, item: siteUrl },
              { "@type": "ListItem", position: 2, name: section, item: pageUrl.href },
            ],
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl.href} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={SITE.paperDark} />
    <meta name="theme-color" content={SITE.paper} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={title} />

    {!noindex && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />}
    <script is:inline>
      (function () {
        var hour = new Date().getHours();
        var wird = hour >= 3 && hour < 12 ? "s" : "m";
        var override = location.search.match(/w=([sm])/);
        if (override) wird = override[1];
        var root = document.documentElement;
        root.dataset.wird = wird;
        document.addEventListener("touchstart", function () {}, { passive: true });

        var metas = document.querySelectorAll('meta[name="theme-color"]');
        var paper = {};
        for (var i = 0; i < metas.length; i++) paper[metas[i].media ? "dark" : "light"] = metas[i].content;
        var device = matchMedia("(prefers-color-scheme: dark)");
        function deviceTheme() {
          return device.matches ? "dark" : "light";
        }
        function current() {
          return root.dataset.theme || deviceTheme();
        }
        function apply(theme) {
          if (theme) root.dataset.theme = theme;
          else delete root.dataset.theme;
          for (var j = 0; j < metas.length; j++) {
            metas[j].content = paper[theme || (metas[j].media ? "dark" : "light")];
          }
        }
        function announce() {
          var buttons = document.querySelectorAll(".theme");
          for (var k = 0; k < buttons.length; k++) buttons[k].setAttribute("aria-pressed", String(current() === "dark"));
        }
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") apply(saved);
        } catch (error) {}
        document.addEventListener("DOMContentLoaded", announce);
        device.addEventListener("change", announce);
        document.addEventListener("click", function (event) {
          if (!event.target.closest(".theme")) return;
          var next = current() === "dark" ? "light" : "dark";
          var follow = next === deviceTheme();
          apply(follow ? null : next);
          try {
            if (follow) localStorage.removeItem("theme");
            else localStorage.setItem("theme", next);
          } catch (error) {}
          announce();
        });
      })();
    </script>
    <noscript><style>.theme, .wird-now { display: none; }</style></noscript>
  </head>
  <body>
    <slot />
  </body>
</html>
