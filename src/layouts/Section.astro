---
import Paper from './Paper.astro';
import Banner from '../components/Banner.astro';
import Bar from '../components/Bar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { ComponentProps } from 'astro/types';
import type { EmblemName } from '../lib/emblems';

interface Props extends ComponentProps<typeof Paper> {
  emblem: EmblemName;
  color: string;
  heading: string;
  evening?: string | undefined;
  lede?: string | undefined;
  kicker?: string | undefined;
  eveningKicker?: string | undefined;
  up?: { href: string; label: string } | undefined;
  turns?: boolean | undefined;
}

const {
  emblem,
  color,
  heading,
  evening,
  lede,
  kicker,
  eveningKicker,
  up,
  turns = false,
  ...paper
} = Astro.props;
---

<Paper {...paper} tone={color}>
  <div class="page">
    <Bar stage />
    <Banner
      title={heading}
      evening={evening}
      lede={lede}
      kicker={kicker}
      eveningKicker={eveningKicker}
      up={up}
      emblem={emblem}
      turns={turns}
    />
    <main class="container">
      <slot />
    </main>
    <slot name="after" />
    <SiteFooter />
  </div>
</Paper>
