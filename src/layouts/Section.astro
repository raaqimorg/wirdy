---
import Paper from './Paper.astro';
import Banner from '../components/Banner.astro';
import Bar from '../components/Bar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { ComponentProps } from 'astro/types';
import type { EmblemName } from '../lib/emblems';

interface Props extends ComponentProps<typeof Paper> {
  emblem: EmblemName;
  color: string;
  heading: string;
  lede?: string;
  back?: { href: string; label: string };
  single?: boolean;
}

const { emblem, color, heading, lede, back, single = false, ...paper } = Astro.props;
---

<Paper {...paper}>
  <div class="tone" style={`--tone: ${color}`}>
    <Bar heading={single ? undefined : heading} back={back} />
    <Banner emblem={emblem} title={heading} lede={lede} single={single}>
      <slot name="banner" />
    </Banner>
    <main class="container">
      <slot />
    </main>
    <slot name="after" />
    <SiteFooter />
  </div>
</Paper>
