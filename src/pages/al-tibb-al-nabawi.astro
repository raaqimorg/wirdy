---
import { Effect, Option } from 'effect';
import EntryList from '../components/EntryList.astro';
import Group from '../components/Group.astro';
import GroupIndex from '../components/GroupIndex.astro';
import Hadith from '../components/Hadith.astro';
import PageTools from '../components/PageTools.astro';
import PosterMenu from '../components/PosterMenu.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import Related from '../components/Related.astro';
import Section from '../layouts/Section.astro';
import { hadithLabel } from '../lib/arabic';
import { sectionCardFile } from '../lib/card';
import { sectionTiles, tibbEntries } from '../lib/collection';
import { runsByGroup } from '../lib/groups';
import { slugOf } from '../lib/permalink';
import { tibbPosterOf } from '../lib/poster';
import { TIBB } from '../lib/site';

const { heading, title, color, path } = TIBB;
const entries = await Effect.runPromise(tibbEntries);
const runs = runsByGroup(entries);
const poster = tibbPosterOf(entries);
const groups = runs.flatMap(({ group }) => Option.toArray(group));
const others = (await Effect.runPromise(sectionTiles)).filter((tile) => tile.id !== 'tibb');

const label = hadithLabel(entries.length);
const description = `${title}: ${label} صحيحة عن النبي ﷺ في التداوي والعسل والحبة السوداء وماء زمزم والحجامة والرقية وحفظ الصحة، ومع كل حديث تخريجه`;
---

<Section
  title={title}
  description={description}
  image={`/${sectionCardFile({ id: 'tibb', title, color, note: label })}`}
  crumbs={[{ name: title, path }]}
  emblem="tibb"
  color={color}
  heading={heading}
  kicker={label}
>
  <PosterMenu slot="bar" posters={[poster]} title={title} path={path} />
  <PageTools>
    <GroupIndex groups={groups} />
  </PageTools>
  <ReadingProgress>
    {runs.map(({ group, items }) => (
      <Group title={Option.getOrUndefined(group)}>
        <EntryList variant="titled">
          {items.map(({ id, data, body = '' }) => (
            <Hadith data={data} body={body} slug={slugOf(id)} />
          ))}
        </EntryList>
      </Group>
    ))}
  </ReadingProgress>
  <Related slot="after" tiles={others} />
</Section>
