---
import Search from '../components/Search.astro';
import Home from '../layouts/Home.astro';
import { searchRows, sectionTiles } from '../lib/collection';
import { SITE } from '../lib/site';
---

<Home title="البحث" description={SITE.description} noindex faces={['naskh']} search={false}>
  <Search tiles={await sectionTiles()} rows={await searchRows()} />
</Home>

<script>
  import { mountSearch } from '../scripts/search';

  mountSearch(document.querySelector<HTMLElement>('[data-search]')!, { restore: true });
</script>
