---
import { Effect } from 'effect';
import Search from '../components/Search.astro';
import Home from '../layouts/Home.astro';
import { searchRows, sectionTiles } from '../lib/collection';
import { SITE } from '../lib/site';
---

<Home title="البحث" description={SITE.description} noindex faces={['naskh']} search={false}>
  <Search
    tiles={await Effect.runPromise(sectionTiles)}
    rows={await Effect.runPromise(searchRows)}
  />
</Home>

<script>
  import { Effect } from 'effect';
  import { element, mountSearch } from '../scripts/search';

  Effect.runSync(
    Effect.flatMap(element(document, '[data-search]', HTMLElement), (root) =>
      mountSearch(root, { restore: true })
    )
  );
</script>
