---
import { Effect } from 'effect';
import Banner from '../components/Banner.astro';
import CardGrid from '../components/CardGrid.astro';
import Home from '../layouts/Home.astro';
import { sectionTiles } from '../lib/collection';
import { SITE } from '../lib/site';

const description = `لم نجد هذه الصفحة في ${SITE.name}. اختر قسمًا من أقسام الأذكار.`;
---

<Home title="الصفحة غير موجودة" description={description} noindex faces={[]}>
  <Banner slot="top" title="لم نجد هذه الصفحة" kicker="٤٠٤" lede="اختر قسمًا، أو ابحث عن الذكر" />
  <CardGrid tiles={await Effect.runPromise(sectionTiles)} variant="featured" />
</Home>
