---
import Dhikr from '../../components/Dhikr.astro';
import DhikrActions from '../../components/DhikrActions.astro';
import EntryList from '../../components/EntryList.astro';
import Neighbours from '../../components/Neighbours.astro';
import WirdSwitch from '../../components/WirdSwitch.astro';
import Section from '../../layouts/Section.astro';
import { cardFile, cardOf } from '../../lib/card';
import { copyOf } from '../../lib/copy';
import { adhkarOf } from '../../lib/collection';
import { OCCASIONS } from '../../lib/occasions';
import { dhikrAnchor, dhikrPath, slugOf } from '../../lib/permalink';
import { phrasesLabel } from '../../lib/phrases';

export async function getStaticPaths() {
  const lists = await Promise.all(OCCASIONS.map(({ id }) => adhkarOf(id)));
  return lists.flatMap((list) =>
    list.map((entry, index) => ({
      params: { occasion: entry.data.occasion, dhikr: slugOf(entry.id) },
      props: { entry, previous: list[index - 1], next: list[index + 1] },
    }))
  );
}

const { entry, previous, next } = Astro.props;
const { data, body = '' } = entry;
const occasion = OCCASIONS.find(({ id }) => id === data.occasion)!;
const slug = slugOf(entry.id);
const path = dhikrPath(data.occasion, slug);
const card = cardOf(data, body);
const image = `/${cardFile(card, data.occasion, slug)}`;
const back = { href: dhikrAnchor(data.occasion, slug), label: occasion.heading };

const count = card.phrases ? phrasesLabel(card.phrases) : card.count;
const description = [card.lead, count, data.fadl, card.takhrij].filter(Boolean).join('. ');
const links = [
  { label: 'التالي', entry: next },
  { label: 'السابق', entry: previous },
].flatMap(({ label, entry: neighbour }) =>
  neighbour
    ? [
        {
          label,
          title: neighbour.data.title,
          href: dhikrPath(data.occasion, slugOf(neighbour.id)),
        },
      ]
    : []
);
---

<Section
  title={`${data.title} | ${occasion.heading}`}
  description={description}
  image={image}
  imageSize={[1200, 630]}
  faces={data.quran ? ['quran'] : ['naskh']}
  crumbs={[
    { name: occasion.heading, path: `/${occasion.id}/` },
    { name: data.title, path },
  ]}
  emblem={occasion.id}
  color={occasion.color}
  heading={data.title}
  back={back}
  single
>
  {card.evening && <WirdSwitch slot="banner" />}
  <EntryList variant="single">
    <Dhikr data={data} body={body} slug={slug} single />
  </EntryList>
  <DhikrActions
    href={path}
    title={data.title}
    image={image}
    file={`wirdy-${slug}.png`}
    copy={copyOf(data, body)}
  />
  <Neighbours links={links} />
</Section>
