---
import { Effect, Option } from 'effect';
import Dhikr from '../../components/Dhikr.astro';
import DhikrActions from '../../components/DhikrActions.astro';
import EntryList from '../../components/EntryList.astro';
import Neighbours from '../../components/Neighbours.astro';
import PageTools from '../../components/PageTools.astro';
import WirdSwitch from '../../components/WirdSwitch.astro';
import Section from '../../layouts/Section.astro';
import { timesLabel } from '../../lib/arabic';
import { cardFile, cardOf } from '../../lib/card';
import { copyOf } from '../../lib/copy';
import { descriptionOf } from '../../lib/description';
import { adhkarOf } from '../../lib/collection';
import { OCCASIONS, sectionOf } from '../../lib/occasions';
import { dhikrAnchor, dhikrPath, slugOf } from '../../lib/permalink';
import { eveningTitle, fullTitle } from '../../lib/title';

export async function getStaticPaths() {
  const lists = await Effect.runPromise(Effect.forEach(OCCASIONS, ({ id }) => adhkarOf(id)));
  return lists.flatMap((list) =>
    list.map((entry, index) => ({
      params: { occasion: entry.data.occasion, dhikr: slugOf(entry.id) },
      props: { entry, previous: list[index - 1], next: list[index + 1] },
    }))
  );
}

const { entry, previous, next } = Astro.props;
const { data, body = '' } = entry;
const occasion = sectionOf(data.occasion);
const slug = slugOf(entry.id);
const path = dhikrPath(data.occasion, slug);
const card = Effect.runSync(cardOf(data, body));
const image = `/${cardFile(card, data.occasion, slug)}`;
const up = { href: dhikrAnchor(data.occasion, slug), label: occasion.heading };
const title = fullTitle(data);
const times = data.count > 1 ? timesLabel(data.count) : undefined;
const named = [data.context, data.group].find(
  (part) => part !== undefined && part !== occasion.heading
);
const parts = [named, times].filter((part) => part !== undefined);
const lede = parts.length === 0 ? occasion.title : parts.join(' · ');
const evening = Effect.runSync(eveningTitle(data.title, body));

const description = descriptionOf(card, data.fadl);
const links = [
  { label: 'التالي', entry: next },
  { label: 'السابق', entry: previous },
].flatMap(({ label, entry: neighbour }) =>
  neighbour === undefined
    ? []
    : [
        {
          label,
          title: neighbour.data.title,
          context: neighbour.data.context,
          href: dhikrPath(data.occasion, slugOf(neighbour.id)),
        },
      ]
);
---

<Section
  title={`${title} | ${occasion.title}`}
  description={description}
  image={image}
  faces={data.quran ? ['quran'] : ['naskh']}
  crumbs={[
    { name: occasion.title, path: `/${occasion.id}/` },
    { name: title, path },
  ]}
  emblem={occasion.id}
  color={occasion.color}
  heading={data.title}
  evening={Option.getOrUndefined(evening)}
  lede={lede}
  up={up}
  turns={card.evening !== null}
>
  {card.evening !== null && (
    <PageTools>
      <WirdSwitch />
    </PageTools>
  )}
  <EntryList variant="single">
    <Dhikr data={data} body={body} slug={slug} single />
  </EntryList>
  <DhikrActions
    href={path}
    title={title}
    image={image}
    file={`wirdy-${slug}.png`}
    copy={Effect.runSync(copyOf(data, body))}
  />
  <Neighbours links={links} />
</Section>
