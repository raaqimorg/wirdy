---
import { Effect } from 'effect';
import CardGrid from '../components/CardGrid.astro';
import Hero from '../components/Hero.astro';
import Home from '../layouts/Home.astro';
import { sectionTiles } from '../lib/collection';
import { SITE } from '../lib/site';

const tiles = await Effect.runPromise(sectionTiles);
---

<Home title={SITE.tagline} description={SITE.description} menu={false}>
  <Hero more={SITE.promise.more}>
    {SITE.promise.before}&nbsp;<span class="salawat">ﷺ</span>
    {SITE.promise.after}
  </Hero>
  <CardGrid tiles={tiles} variant="featured" />
</Home>
