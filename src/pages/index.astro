---
import CardGrid from '../components/CardGrid.astro';
import Hero from '../components/Hero.astro';
import Home from '../layouts/Home.astro';
import { occasionTiles } from '../lib/collection';
import { SITE, UNPROVEN } from '../lib/site';

const { heading, color, note, path: href } = UNPROVEN;
const tiles = [...(await occasionTiles()), { id: 'unproven' as const, heading, color, note, href }];
---

<Home title="أذكار اليوم والليلة" description={SITE.description}>
  <Hero>
    أذكار اليوم والليلة، مما ثبت عن النبي&nbsp;<span class="salawat">ﷺ</span>، ومع كل ذكر تخريجُه
  </Hero>
  <CardGrid tiles={tiles} variant="featured" />
</Home>
