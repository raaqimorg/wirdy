---
import { Effect } from 'effect';
import SectionBands from '../components/SectionBands.astro';
import Hero from '../components/Hero.astro';
import Home from '../layouts/Home.astro';
import { bandTiles } from '../lib/collection';
import { SITE } from '../lib/site';

const bands = await Effect.runPromise(bandTiles);
---

<Home title={SITE.tagline} description={SITE.description} menu={false}>
  <Hero more={SITE.promise.more}>
    {SITE.promise.before}&nbsp;<span class="salawat">ﷺ</span>
    {SITE.promise.after}
  </Hero>
  <SectionBands bands={bands} />
</Home>
