---
import { Effect, Option } from 'effect';
import Group from '../components/Group.astro';
import GroupIndex from '../components/GroupIndex.astro';
import PageTools from '../components/PageTools.astro';
import Related from '../components/Related.astro';
import WirdSwitch from '../components/WirdSwitch.astro';
import Section from '../layouts/Section.astro';
import { adhkarLabel } from '../lib/arabic';
import { adhkarOf, sectionTiles } from '../lib/collection';
import { runsByGroup } from '../lib/groups';
import { OCCASIONS } from '../lib/occasions';

export function getStaticPaths() {
  return OCCASIONS.map((occasion) => ({ params: { occasion: occasion.id }, props: { occasion } }));
}

const { id, heading, color, lede } = Astro.props.occasion;
const entries = await Effect.runPromise(adhkarOf(id));
const runs = runsByGroup(entries);
const groups = runs.flatMap(({ group }) => Option.toArray(group));
const hasIndex = runs.length > 1 && groups.length === runs.length;
const others = (await Effect.runPromise(sectionTiles)).filter((tile) => tile.id !== id);
const hasQuran = entries.some(({ data }) => data.quran);
const hasVariants = entries.some((entry) => entry.body?.includes('{{') === true);

const label = adhkarLabel(entries.length);
const labelAt = (time: 'sabah' | 'masaa') =>
  adhkarLabel(entries.filter(({ data }) => data.mode === 'both' || data.mode === time).length);
const description = `${heading}: ${label} مما ثبت عن النبي ﷺ، بالتشكيل وعدد المرات، وتحت كل ذكر تخريجه من الدرر السنية.`;
---

<Section
  title={heading}
  description={description}
  image={`/opengraph-${id}.png`}
  crumbs={[{ name: heading, path: `/${id}/` }]}
  faces={hasQuran ? ['naskh', 'quran'] : ['naskh']}
  emblem={id}
  color={color}
  heading={heading}
  kicker={hasVariants ? labelAt('sabah') : label}
  eveningKicker={hasVariants ? labelAt('masaa') : undefined}
  lede={lede}
  turns={hasVariants}
>
  <PageTools>
    {hasVariants && <WirdSwitch />}
    {hasIndex && <GroupIndex groups={groups} />}
  </PageTools>
  {runs.map(({ group, items }) => (
    <Group title={Option.getOrUndefined(group)} entries={items} />
  ))}
  <Related slot="after" tiles={others} />
</Section>
